                                    </svg>

                                    <div class="svg-wrapper" style="display:none;">
                                      <svg
                                        class="icon icon-checkmark"
                                        width="16"
                                        height="16"
                                        viewBox="0 0 16 16"
                                        fill="none"
                                        xmlns="http://www.w3.org/2000/svg"
                                      >
                                        <mask id="path-1-outside-1_22_2251" maskUnits="userSpaceOnUse" x="0" y="0" width="16" height="16" fill="black">
                                        <rect fill="white" width="16" height="16"/>
