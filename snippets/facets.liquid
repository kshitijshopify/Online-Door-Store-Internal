                                        </mask>
                                        <path d="M3 1H13C14.0938 1 15 1.90625 15 3V13C15 14.125 14.0938 15 13 15H3C1.875 15 1 14.125 1 13V3C1 1.90625 1.875 1 3 1ZM11.5312 6.53125H11.5C11.8125 6.25 11.8125 5.78125 11.5 5.46875C11.2188 5.1875 10.75 5.1875 10.4688 5.46875L7 8.96875L5.53125 7.5C5.21875 7.1875 4.75 7.1875 4.46875 7.5C4.15625 7.78125 4.15625 8.25 4.46875 8.53125L6.46875 10.5312C6.75 10.8438 7.21875 10.8438 7.53125 10.5312L11.5312 6.53125Z" fill="#30309F"/>
                                        <path d="M11.5312 6.53125L12.2384 7.23836L13.9455 5.53125H11.5312V6.53125ZM11.5 6.53125L10.831 5.78796L8.89404 7.53125H11.5V6.53125ZM10.4688 5.46875L9.76164 4.76164L9.75848 4.76482L10.4688 5.46875ZM7 8.96875L6.29289 9.67586L7.00318 10.3861L7.71027 9.67268L7 8.96875ZM4.46875 7.5L5.13771 8.24329L5.17684 8.20809L5.21204 8.16896L4.46875 7.5ZM4.46875 8.53125L5.17586 7.82414L5.15726 7.80555L5.13771 7.78796L4.46875 8.53125ZM6.46875 10.5312L7.21204 9.86229L7.19445 9.84274L7.17586 9.82414L6.46875 10.5312ZM3 1V2H13V1V0H3V1ZM13 1V2C13.5415 2 14 2.45853 14 3H15H16C16 1.35397 14.646 0 13 0V1ZM15 3H14V13H15H16V3H15ZM15 13H14C14 13.5626 13.5517 14 13 14V15V16C14.6358 16 16 14.6874 16 13H15ZM13 15V14H3V15V16H13V15ZM3 15V14C2.42728 14 2 13.5727 2 13H1H0C0 14.6773 1.32272 16 3 16V15ZM1 13H2V3H1H0V13H1ZM1 3H2C2 2.44831 2.43745 2 3 2V1V0C1.31255 0 0 1.36419 0 3H1ZM11.5312 6.53125V5.53125H11.5V6.53125V7.53125H11.5312V6.53125ZM11.5 6.53125L12.169 7.27454C12.9447 6.57638 12.8883 5.44281 12.2071 4.76164L11.5 5.46875L10.7929 6.17586C10.7696 6.15252 10.7344 6.09656 10.7344 6.01172C10.7344 5.92377 10.7735 5.83972 10.831 5.78796L11.5 6.53125ZM11.5 5.46875L12.2071 4.76164C11.5353 4.08987 10.4334 4.08987 9.76164 4.76164L10.4688 5.46875L11.1759 6.17586C11.1167 6.23503 11.0442 6.25781 10.9844 6.25781C10.9245 6.25781 10.8521 6.23503 10.7929 6.17586L11.5 5.46875ZM10.4688 5.46875L9.75848 4.76482L6.28973 8.26482L7 8.96875L7.71027 9.67268L11.179 6.17268L10.4688 5.46875ZM7 8.96875L7.70711 8.26164L6.23836 6.79289L5.53125 7.5L4.82414 8.20711L6.29289 9.67586L7 8.96875ZM5.53125 7.5L6.23836 6.79289C5.55719 6.11173 4.42362 6.0553 3.72546 6.83104L4.46875 7.5L5.21204 8.16896C5.16028 8.22648 5.07623 8.26562 4.98828 8.26562C4.90344 8.26562 4.84748 8.23045 4.82414 8.20711L5.53125 7.5ZM4.46875 7.5L3.79979 6.75671C3.0459 7.4352 3.0459 8.59605 3.79979 9.27454L4.46875 8.53125L5.13771 7.78796C5.19301 7.83772 5.23438 7.92076 5.23438 8.01562C5.23438 8.11049 5.19301 8.19353 5.13771 