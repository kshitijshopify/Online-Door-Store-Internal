{% assign upsell_products = product.metafields.custom.you_may_also_need.value %}
{% if upsell_products != blank %}
  
  <div id="nx-upsell-{{ section.id }}-{{ block.id }}" class="nx-upsell" {{ block.shopify_attributes }}>
    <style>
      .nx-upsell__heading {
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 12px;
        color: #212133;
      }
      .nx-upsell__swiper {
        position: relative;
        padding-right: 1px;
      }
      .nx-upsell-card {
        position: relative;
        border: 1px solid #D5D5E5;
        border-radius: 2px;
        padding: 8px;
        background-color: #ffffff;
        display: flex;
        flex-direction: column;
        height: 100%;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
      }
      .nx-upsell-card.is-selected {
        border-color: #30309F;
      }
      .nx-upsell-card__check {
        display: block !important;
      }
      .nx-upsell-card__check {
        position: absolute;
        top: 8px;
        left: 8px;
        width: 14px;
        height: 14px;
        border-radius: 3px;
        background-color: #F1F1F9;
      }
      .nx-upsell-card__check svg {
        display: none;
      }
      .nx-upsell-card.is-selected .nx-upsell-card__check svg {
        display: block;
      }
      .nx-upsell-card__image {
        display: block;
        margin-bottom: 12px;
      }
      .nx-upsell-card__image img {
        width: 100%;
        height: auto;
        display: block;
      }
      .nx-upsell-card__body {
        display: flex;
        flex-direction: column;
        gap: 4px;
        flex: 1 1 auto;
      }
      .nx-upsell-card__vendor {
        font-size: 13px;
        text-transform: none;
        letter-spacing: normal;
        color: #30309F;
        line-height: 1.38;
        margin-top: 6px;
      }
      .nx-upsell-card__title {
        font-size: 13px;
        font-weight: 700;
        color: #212133;
        text-decoration: none;
        line-height: 1.38;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        text-overflow: ellipsis;
      }
      .nx-upsell-card__price {
        font-size: 13px;
        color: #30309F;
        margin-top: 4px;
        font-weight: 700;
      }
      .nx-upsell-card__title:hover {
        text-decoration: underline;
      }
    
      .nx-upsell-card__footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        margin-top: -6px;
      }
      .nx-upsell-card__more {
        font-size: 13px;
        text-decoration: underline;
        color: #212133;
        line-height: 1.38;
      }
      .nx-upsell-card__btn {
          display: flex;
          align-items: center;
          justify-content: center;
          cursor: pointer;
          padding: 0;
          background: none;
          border: none;
      }
      .nx-upsell-card__btn-icon {
        font-size: 20px;
        line-height: 1;
      }
      .nx-upsell-card__btn-icon--minus {
        display: none;
      }
      .nx-upsell-card.is-selected .nx-upsell-card__btn-icon--plus {
        display: none;
      }
      .nx-upsell-card.is-selected .nx-upsell-card__btn-icon--minus {
        display: inline-block;
      }
      
      .nx-upsell__pagination {
        text-align: center;
        width: fit-content !important;
      }
      .nx-upsell__nav--prev,
      .nx-upsell__nav--next,
      .nx-upsell__pagination {
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }
      #nx-upsell-{{ section.id }}-{{ block.id }} .swiper-pagination-bullet {
        width: 12px;
        height: 12px;
        opacity: 1;
        margin: 0 6px;
        background: transparent;
        border: 1px solid #212133;
      }
      #nx-upsell-{{ section.id }}-{{ block.id }} .swiper-pagination-bullet-active {
        background-color: #191a2f;
      }
      .nx-upsell__nav--prev {
        margin-right: 8px;
        transform: scale(-1);
      }
      .nx-upsell__nav:empty {
        display: inline-flex;
        margin: 0;
      }
      .navigation_arrows {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-top: 16px;
        gap: 26px;
      }
      .nx-upsell__swiper .swiper-slide {
        width: 33.33%;
        margin-right: 8px;
      }
      .nx-upsell__nav.swiper-button-disabled {
        opacity: .5;
        cursor: auto;
      }
      .nx-upsell__nav {
        margin: 0;
        cursor: pointer;
      }
      .nx-upsell__swiper .swiper-button-disabled.swiper-button-lock {
        display: none;
      }
      .nx-upsell-card__loader {
        position: absolute;
        inset: 0;
        background: rgba(255, 255, 255, 0.6);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 2;
      }

      .nx-upsell-card__loader::after {
        content: "";
        width: 22px;
        height: 22px;
        border-radius: 50%;
        border: 2px solid #c8c8d9;
        border-top-color: #30309F;
        animation: nx-upsell-spin 0.6s linear infinite;
      }

      .nx-upsell-card.is-loading .nx-upsell-card__loader {
        display: flex;
      }

      .nx-upsell-card.is-loading {
        pointer-events: none;
      }

      @keyframes nx-upsell-spin {
        to {
          transform: rotate(360deg);
        }
      }

    </style>
    {% if block.settings.heading != blank %}
      <h3 class="nx-upsell__heading">{{ block.settings.heading }}</h3>
    {% endif %}

    <div class="swiper nx-upsell__swiper">
      <div class="swiper-wrapper">
        {% for upsell_product in upsell_products %}
          {% if upsell_product %}
            {% assign v = upsell_product.selected_or_first_available_variant %}
            <div class="swiper-slide">
              <article
                class="nx-upsell-card"
                data-variant-id="{{ v.id }}"
                data-product-handle="{{ upsell_product.handle }}"
              >
                  <div class="nx-upsell-card__loader"></div>

                <div class="nx-upsell-card__check">
                  {% render 'icon-tick' %}
                </div>

                <a href="{{ upsell_product.url }}" class="nx-upsell-card__image">
                  {% if upsell_product.featured_image %}
                    {{ upsell_product.featured_image | image_url: width: 480 | image_tag: loading: 'lazy' }}
                  {% endif %}
                </a>

                <div class="nx-upsell-card__body">
                  <div class="nx-upsell-card__vendor">{{ upsell_product.vendor }}</div>
                  <a href="{{ upsell_product.url }}" class="nx-upsell-card__title">
                    {{ upsell_product.title }}
                  </a>
                  <div class="nx-upsell-card__price">
                    {{ v.price | money }}
                  </div>

                  <div class="nx-upsell-card__footer">
                    <a href="{{ upsell_product.url }}" class="nx-upsell-card__more">
                      {{ block.settings.more_info_label }}
                    </a>

                    <button type="button" class="nx-upsell-card__btn" data-variant-id="{{ v.id }}">
                      <span class="nx-upsell-card__btn-icon nx-upsell-card__btn-icon--plus">
                        <svg width="25" height="23" viewBox="0 0 25 23" fill="none" xmlns="http://www.w3.org/2000/svg">
