C10.6133 6.1875 10.3125 5.88672 10.3125 5.5Z" fill="#212133"/>
                        </svg>
                      </span>
                      <span class="nx-upsell-card__btn-icon nx-upsell-card__btn-icon--minus">
                        <svg width="25" height="23" viewBox="0 0 25 23" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M0 0.6875C0 0.34375 0.300781 0 0.6875 0H2.27734C3.26562 0 4.125 0.6875 4.29688 1.67578L6.23047 11H20.0234C20.668 11 21.2266 10.5703 21.3555 9.96875L23.375 1.93359C23.4609 1.54688 23.8477 1.33203 24.1914 1.41797C24.5781 1.50391 24.793 1.89062 24.707 2.23438L22.6875 10.3125C22.3867 11.5156 21.2695 12.375 20.0234 12.375H6.53125L6.83203 14.0508C6.96094 14.6953 7.5625 15.125 8.20703 15.125H21.3125C21.6562 15.125 22 15.4688 22 15.8125C22 16.1992 21.6562 16.5 21.3125 16.5H8.20703C6.875 16.5 5.75781 15.5977 5.5 14.3086L2.96484 1.93359C2.92188 1.63281 2.62109 1.375 2.27734 1.375H0.6875C0.300781 1.375 0 1.07422 0 0.6875ZM8.25 20.625C8.80859 20.625 9.28125 20.1953 9.28125 19.5938C9.28125 19.0352 8.80859 18.5625 8.25 18.5625C7.64844 18.5625 7.21875 19.0352 7.21875 19.5938C7.21875 20.1953 7.64844 20.625 8.25 20.625ZM8.25 17.1875C9.10938 17.1875 9.88281 17.6602 10.3125 18.3906C10.7422 19.1641 10.7422 20.0664 10.3125 20.7969C9.88281 21.5703 9.10938 22 8.25 22C7.34766 22 6.57422 21.5703 6.14453 20.7969C5.71484 20.0664 5.71484 19.1641 6.14453 18.3906C6.57422 17.6602 7.34766 17.1875 8.25 17.1875ZM20.2812 19.5938C20.2812 19.0352 19.8086 18.5625 19.25 18.5625C18.6484 18.5625 18.2188 19.0352 18.2188 19.5938C18.2188 20.1953 18.6484 20.625 19.25 20.625C19.8086 20.625 20.2812 20.1953 20.2812 19.5938ZM16.8438 19.5938C16.8438 18.7344 17.2734 17.9609 18.0469 17.5312C18.7773 17.1016 19.6797 17.1016 20.4531 17.5312C21.1836 17.9609 21.6562 18.7344 21.6562 19.5938C21.6562 20.4961 21.1836 21.2695 20.4531 21.6992C19.6797 22.1289 18.7773 22.1289 18.0469 21.6992C17.2734 21.2695 16.8438 20.4961 16.8438 19.5938ZM11 4.8125H16.5C16.8438 4.8125 17.1875 5.15625 17.1875 5.5C17.1875 5.88672 16.8438 6.1875 16.5 6.1875H11C10.6133 6.1875 10.3125 5.88672 10.3125 5.5C10.3125 5.15625 10.6133 4.8125 11 4.8125Z" fill="#212133"/>
                        </svg>
                      </span>
                    </button>
                  </div>
                </div>
              </article>
            </div>
          {% endif %}
        {% endfor %}
      </div>
      <div class="navigation_arrows">
        <div class="nx-upsell__nav nx-upsell__nav--prev">
          <svg width="21" height="13" viewBox="0 0 21 13" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M19.8047 6.75781L14.1797 12.3828C13.9453 12.6172 13.5156 12.6172 13.2812 12.3828C13.0469 12.1484 13.0469 11.7188 13.2812 11.4844L17.8516 6.91406H0.625C0.273438 6.91406 0 6.64062 0 6.28906C0 5.97656 0.273438 5.66406 0.625 5.66406H17.8516L13.2812 1.13281C13.0469 0.898438 13.0469 0.46875 13.2812 0.234375C13.5156 0 13.9453 0 14.1797 0.234375L19.8047 5.85938C20.0391 6.09375 20.0391 6.52344 19.8047 6.75781Z" fill="#212133"/>
          </svg>
        </div>
        <div class="nx-upsell__pagination"></div>
        <div class="nx-upsell__nav nx-upsell__nav--next">
          <svg width="21" height="13" viewBox="0 0 21 13" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M19.8047 6.75781L14.1797 12.3828C13.9453 12.6172 13.5156 12.6172 13.2812 12.3828C13.0469 12.1484 13.0469 11.7188 13.2812 11.4844L17.8516 6.91406H0.625C0.273438 6.91406 0 6.64062 0 6.28906C0 5.97656 0.273438 5.66406 0.625 5.66406H17.8516L13.2812 1.13281C13.0469 0.898438 13.0469 0.46875 13.2812 0.234375C13.5156 0 13.9453 0 14.1797 0.234375L19.8047 5.85938C20.0391 6.09375 20.0391 6.52344 19.8047 6.75781Z" fill="#212133"/>
          </svg>
        </div>
      </div>
    </div>
    
    <script>
      (function () {
        var root = document.getElementById('nx-upsell-{{ section.id }}-{{ block.id }}');
        if (!root) return;

        function initSwiper() {
          var swiperEl = root.querySelector('.nx-upsell__swiper');
          if (swiperEl && typeof Swiper !== 'undefined') {
            new Swiper(swiperEl, {
              slidesPerView: 3,
              spaceBetween: 8,
              pagination: {
                el: root.querySelector('.nx-upsell__pagination'),
                clickable: true
              },
              navigation: {
                nextEl: root.querySelector('.nx-upsell__nav--next'),
                prevEl: root.querySelector('.nx-upsell__nav--prev')
              },
              breakpoints: {
                0: {
                  slidesPerView: 2.2,
                  spaceBetween: 8,
                },
                850: {
                  slidesPerView: 3,
                  spaceBetween: 8,
                }
              } 
            });
          }
        }

        if (typeof Swiper === 'undefined') {
          var swiperScript = document.querySelector('#nx-swiper-js');
          if (swiperScript) {
            swiperScript.addEventListener('load', initSwiper);
          } else {
            window.addEventListener('load', initSwiper);
          }
        } else {
          initSwiper();
        }

        function updateCartCount() {
          fetch('/')
            .then(response => response.text())
            .then(html => {
              var temp = document.createElement('div');
              temp.innerHTML = html;

              var newBubble = temp.querySelector('#cart-icon-bubble');
              var oldBubble = document.querySelector('#cart-icon-bubble');

              if (newBubble && oldBubble) {
                oldBubble.innerHTML = newBubble.innerHTML;
              }
            });
        }


        function fetchCartAndSync() {
          return fetch('/cart.js')
            .then(r => r.json())
            .then(cart => {
              applyCartState(cart);
              updateCartCount(); 
            });
        }

        function applyCartState(cart) {
          var byVariant = {};
          cart.items.forEach(function (item) {
            byVariant[item.variant_id] = item.quantity;
          });
          root.querySelectorAll('.nx-upsell-card').forEach(function (card) {
            var variantId = parseInt(card.getAttribute('data-variant-id'), 10);
            var hasItem = byVariant[variantId] && byVariant[variantId] > 0;
            if (hasItem) {
              card.classList.add('is-selected');
            } else {
              card.classList.remove('is-selected');
            }
          });
        }

        fetchCartAndSync();

        root.addEventListener('click', function (event) {
          var btn = event.target.closest('.nx-upsell-card__btn');
          if (!btn) return;
          var card = btn.closest('.nx-upsell-card');
          if (!card) return;
          var variantId = btn.getAttribute('data-variant-id');
          if (!variantId) return;
          var isSelected = card.classList.contains('is-selected');

          card.classList.add('is-loading');
          btn.disabled = true;

          var url;
          var body = new URLSearchParams();
          if (!isSelected) {
            url = '/cart/add.js';
            body.append('id', variantId);
            body.append('quantity', '1');
          } else {
            url = '/cart/update.js';
            body.append('updates[' + variantId + ']', '0');
          }
          fetch(url, {
            method: 'POST',
            headers: {
              Accept: 'application/json',
              'X-Requested-With': 'XMLHttpRequest'
            },
            body: body
          })
            .then(function () {
              return fetchCartAndSync();
            })
            .finally(function () {
              btn.disabled = false;
              card.classList.remove('is-loading');
            });
        });

      })();
    </script>
  </div>
{% endif %}
