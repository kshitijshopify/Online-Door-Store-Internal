{% comment %}
  product: product Object
  hover_image: Boolean, true if show second image on hover
  vendor: Boolean, true if show vendor
  rating: Boolean, true if show product rating
  lazy_load:Booelean ,If Imahe Lazy Load

  {% render 'new-card-product', product:product, hover_image: true, vendor:true, rating:false %}
{% endcomment %}

{% assign section_id = section.id | handle %}
{% comment %}
  {% style %}
      #{{ section_id }} .cst-product-card {
          border-radius: 2px;
          overflow: hidden;
          transition: box-shadow 0.3s ease;
          background: transparent;
      }
      #{{ section_id }} .cst-product-card .cst-product-img-box {
          position: relative;
          overflow: hidden;
          aspect-ratio: 1/1;
      }
      #{{ section_id }} .cst-product-card .cst-img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          transition: transform 0.3s ease;
      }
      #{{ section_id }} .cst-product-card:hover .cst-product-img-box .cst-img {
          transform: scale(1.05);
      }
      #{{ section_id }} .cst-product-card .cst-img-secondary {
          position: absolute;
          top: 0;
          left: 0;
          opacity: 0;
          transition: opacity 0.3s ease;
      }
      #{{ section_id }} .cst-product-card:hover .cst-img-secondary {
          opacity: 1;
      }
      #{{ section_id }} .cst-product-card .cst-card-content {
          padding: 1rem;
      }
      #{{ section_id }} .cst-product-card .cst-vendor {
          font-size: 0.875rem;
          color: #212133;
          margin-bottom: 0.25rem;
          font-family: Montserrat, sans-serif;
      }
      #{{ section_id }} .cst-product-card .cst-product-title {
          font-family: Montserrat, sans-serif;
          font-weight: 700;
          font-style: normal;
          font-size: 14px;
          line-height: 20px;
          margin: 0 0 20px 0;
          color: #212133;
      }
      #{{ section_id }} .cst-product-card .cst-product-link {
          text-decoration: none;
          color: inherit;
      }
      #{{ section_id }} .cst-product-card .cst-price-container {
          margin-bottom: 0.5rem;
      }
      #{{ section_id }} .cst-product-card .cst-price-from {
          font-family: Montserrat, sans-serif;
          font-weight: 400;
          font-style: normal;
          font-size: 13px;
          line-height: 18px;
          letter-spacing: 0%;
          vertical-align: middle;
          color: #212133;
      }
      #{{ section_id }} .cst-product-card .cst-price {
          font-family: Montserrat, sans-serif;
          font-weight: 600;
          font-style: normal;
          font-size: 16px;
          line-height: 20px;
          vertical-align: middle;
          color: #30309f;
      }
      #{{ section_id }} .cst-product-card .cst-price-compare {
          font-family: Montserrat, sans-serif;
          font-weight: 400;
          font-style: normal;
          font-size: 13px;
          line-height: 18px;
          letter-spacing: 0%;
          vertical-align: middle;
          text-decoration: line-through;
          color: #999;
          margin-left: 0.25rem;
      }
      #{{ section_id }} .cst-product-card .cst-price-inc {
          font-family: Montserrat, sans-serif;
          font-weight: 400;
          font-style: normal;
          font-size: 13px;
          line-height: 18px;
          color: #212133;
      }
      #{{ section_id }} .cst-product-card .cst-product-availability {
          display: flex;
          align-items: center;
          gap: 0.5rem;
          margin-bottom: 0.5rem;
      }
      #{{ section_id }} .cst-product-card .cst-product-availability svg {
          flex-shrink: 0;
      }
      #{{ section_id }} .cst-product-card .cst-avilability-text {
          font-family: Montserrat, sans-serif;
          font-size: 13px;
          line-height: 18px;
          letter-spacing: 0%;
          vertical-align: middle;
      }
      #{{ section_id }} .cst-product-card .cst-instock {
          font-weight: 700;
          color: #212133;
      }
      #{{ section_id }} .cst-product-card .cst-within {
          font-weight: 400;
          color: #212133;
      }
      #{{ section_id }} .cst-product-card .cst-product-rating {
          margin-bottom: 0.5rem;
      }
  {% endstyle %}
{% endcomment %}

<div class="cst-product-card">
  <div class=" cst-product-img-box">
    <a href="{{ product.url }}" class="cst-product-link">
      <img
        src="{{ product.featured_image | img_url: '400x400', crop: 'center' }}"
        class="cst-img"
        alt="{{ product.featured_image.alt }}"
        {% if lazy_load %}
          loading="lazy"
        {% endif %}
        width="auto"
        height="auto"
      >

      {% if hover_image and product.images.size > 1 %}
        <img
          class=" cst-img cst-img-secondary"
          src="{{ product.images[1] | img_url: '400x400', crop: 'center' }}"
          alt="{{ product.images[1].alt }}"
          {% if lazy_load %}
            loading="lazy"
          {% endif %}
          width="auto"
          height="auto"
        >
      {% endif %}
    </a>
  </div>

  <div class="cst-card-content">
    {% if vendor and product.vendor != blank %}
      <div class="cst-vendor">{{ product.vendor }}</div>
    {% endif %}

    <h3 class="cst-product-title">
      <a href="{{ product.url }}" class="cst-product-link">{{ product.title }}</a>
    </h3>

    <div class=" cst-price-container">
      {% if product.price_min < product.price_max %}
        <span class="cst-price-from">From </span>
      {% endif %}
      <span class="cst-price">{{ product.price | money }}</span>
      {% if product.compare_at_price > product.price %}
        <span class="cst-price-compare">{{ product.compare_at_price | money }}</span>
      {% endif %}
      <span class="cst-price-inc"> Inc. VAT</span>
    </div>

    {% if product.available %}
      <div class=" cst-product-availability">
        <svg width="15" height="11" viewBox="0 0 15 11" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M13.8125 0.40625C14.2188 0.78125 14.2188 1.4375 13.8125 1.8125L5.8125 9.8125C5.4375 10.2188 4.78125 10.2188 4.40625 9.8125L0.40625 5.8125C0 5.4375 0 4.78125 0.40625 4.40625C0.78125 4 1.4375 4 1.8125 4.40625L5.125 7.6875L12.4062 0.40625C12.7812 0 13.4375 0 13.8125 0.40625Z" fill="#30309F"/>
        </svg>
        <span class=" cst-avilability-text">
          <span class=" cst-instock">In Stock</span>
          <span class=" cst-within"> | Despatched within 24 Hrs</span>
        </span>
      </div>
    {% endif %}

    {% if rating %}
      <div class="cst-product-rating">
        <!-- Rating widget would go here -->
        <div class="cst-stars">★★★★★</div>
      </div>
    {% endif %}

    {% comment %}
      {% if section.settings.quick_add != 'none' %}
          <div class="product-card__quick-add">
          {% if section.settings.quick_add == 'standard' %}
              <button class="button button--primary" data-product-id="{{ product.id }}">Add to Cart</button>
          {% elsif section.settings.quick_add == 'bulk' %}
              <div class="quick-add-bulk">
              <button class="button button--primary" data-product-id="{{ product.id }}">Quick Add</button>
              </div>
          {% endif %}
          </div>
      {% endif %}
    {% endcomment %}
  </div>
</div>
