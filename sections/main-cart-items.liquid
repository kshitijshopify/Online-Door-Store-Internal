{{ 'component-cart.css' | asset_url | stylesheet_tag }}
{{ 'component-cart-items.css' | asset_url | stylesheet_tag }}
{{ 'component-totals.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-discounts.css' | asset_url | stylesheet_tag }}
{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}

{% assign section_id = section.id | handle %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- unless settings.cart_type == 'drawer' -%}
  <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
<style>
  .title-wrapper-with-link h1{
    font-size: 32px;
    font-weight: 600;
    line-height: 36px;
    text-transform: uppercase;
    color: #30309f;
  }
  .title-wrapper-with-link span{
    font-size: 13px;
    color: #0D223F;
    text-transform: lowercase;
    font-weight: 400;
  }
  .title-wrapper-with-link {
    margin: 4rem 0 3rem;
  }
  .cart-item{
    display: flex;
    background: #F5F5F5;
    padding: 16px;
    margin-bottom: 8px;
    justify-content: space-between;
    align-items: center;
  }
  .cart-items td{
    padding-top:0px;
  }
  .cart-item__name{
    font-size: 14px;
    line-height: 20px;
    color: #071739;
    max-width: 373px;
    font-weight: 700;
  }
  .product-option-variant{
    font-weight: 700;
    font-size: 14px;
    line-height: 20px;
    vertical-align: middle;
    text-transform: capitalize;
  }
  .product-card__availability-instock{
    font-weight:700;
  }
  .product-card__availability{
    font-size:13px;
    line-height:18px;
    color:#212133;
  }
  .product-card__availability{
    display: flex;
    justify-content: start;
    align-items: center;
    gap: 5px;
  }
  .cart-item__price-wrapper .price--end{
    font-size: 20px;
    line-height: 24px;
    color: #30309F;
    font-weight: 600;
  }
  .cart-item__totals .compare_at_price{
    font-size: 16px;
    font-weight: 400;
    text-decoration: line-through;
    color: #212133;
    line-height: 22px;
  }
  .quantity
  {
    font-size: 14px;
    color: #212133;
    border: 1px solid #212133;
  }
  .cart__items{
    border-bottom:none;
  }
  .continue_shopping_btn{
    padding: 20px 32px;
    font-weight: 700;
    font-size: 15px;
    line-height: 18px;
    text-decoration: none;
    text-align: center;
    text-transform: uppercase;
    border: 1px solid #212133;
  }
</style>

{% style %}
  #{{ section_id }} .cst-container {
    max-width: 1602px;
    margin-inline: auto;
    padding-inline: 56px;
    padding-top: 64px;
    padding-bottom: 96px;
    display: flex;
    gap: 96px;
  }
  #{{ section_id }} .cst-col {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  #{{ section_id }} .cst-cart-items-container {
    flex: 1 0 65%;
  }
  #{{ section_id }} .cst-container .cst-summary-box {
    background: #212133;
    color: #fff;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  #{{ section_id }} .cst-container .cst-summary-box h5 {
    font-size: 20px;
    font-weight: 600;
    color: inherit;
    line-height: 24px;
    margin: 0;
    letter-spacing: 5%;
    text-transform: uppercase;
  }
  #{{ section_id }} .cst-container .cst-summary-box hr {
    background: #fff;
    margin: 0;
  }
  #{{ section_id }} .cst-container .cst-summary-box p {
    margin: 0;
    padding: 0;
  }
  #{{ section_id }} .cst-container .cst-summary-box .cst-row {
    display: flex;
    justify-content: space-between;
    font-size: 14px;
    line-height: 20px;
    letter-spacing: 0%;
  }
  #{{ section_id }} .cst-container .cst-summary-box .cst-row > span,
  #{{ section_id }} .cst-container .cst-summary-box .cst-row > p {
    margin: 0;
    padding: 0;
    max-width: 50%;
  }
  #{{ section_id }} .cst-container .cst-summary-box .cst-row-vat {
    display: flex;
    justify-content: space-between;
    font-size: 14px;
    line-height: 20px;
    letter-spacing: 0%;
  }
  #{{ section_id }} .cst-container .cst-summary-box .cst-row-vat > span,
  #{{ section_id }} .cst-container .cst-summary-box .cst-row-vat > p {
    margin: 0;
    padding: 0;
    max-width: 50%;
  }
  #{{ section_id }} .cst-container .cst-big-text {
    font-size: 20px;
    font-weight: 600;
    color: inherit;
    line-height: 24px;
    letter-spacing: 5%;
  }
  #{{ section_id }} .cst-container .cst-btn {
    max-width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-inline: 24px;
    height: 50px;
    background: #30309F;
    border: 0;
    outline: 0;
  }
  #{{ section_id }} .cst-container .cst-center {
    display: flex;
    justify-content: center;
  }
  #{{ section_id }} .cst-container .cst-link {
    text-decoration: underline;
    color: inherit;
  }
  #{{ section_id }} .cst-container .cst-payment-icons {
    display: flex;
    justify-content: center;
    align-items: center;
    max-width: 224px;
    gap: 8px;
    margin-inline: auto;
  }
  #{{ section_id }} .cst-container .cst-payment-icons svg {
    flex: 1;
  }
  #{{ section_id }} .cst-container .cst-review-flex {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
  }
  #{{ section_id }} .cst-container .cst-review-flex span {
    font-size: 16px;
    line-height: 22px;
    font-weight: 400;
  }

  #{{ section_id }} .cst-container .cst-details {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  #{{ section_id }} .cst-container .cst-details p {
    margin: 0;
    padding: 0;
    text-align: center;
    font-size: 13px;
    line-height: 18px;
  }
  #{{ section_id }} .cst-container .cst-shipping-details {
    display: flex;
    flex-direction: column;
    gap: 48px;
    justify-content: center;
    padding-inline: 24px;
    padding-block: 40px 32px;
    border: 3px solid #30309F;
    position: relative;
  }
  #{{ section_id }} .cst-container .cst-shipping-details .cst-logo-box {
    display: flex;
    width: 240px;
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
  }
  #{{ section_id }} .cst-container .cst-details .cst-review-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    padding: 24px;
    background: #EBEBFF;
  }
  #{{ section_id }} .cst-container .cst-details .cst-review-icon {
    display: flex;
  }
  #{{ section_id }} .cst-container .cst-details .cst-list {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 8px;
  }

  @media(max-width: 1024px) {
    #{{ section_id }} .cst-container {
      padding-inline: 32px;
      gap: 32px;
      flex-direction: column;
    }
  }
  @media(max-width: 768px) {
    #{{ section_id }} .cst-container {
      padding-inline:16px;
      padding-top: 32px;
      padding-bottom: 56px;
      gap: 16px;
      flex-direction: column;
    }
  }

  #{{ section_id }} .cart-items {}
  #{{ section_id }} .cart-items .cart-items-container {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  #{{ section_id }} .cart-items .cart-item {
    background: #F5F5F5;
    padding: 16px;
    margin: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 48px;
  }
  #{{ section_id }} .cart-items .cart-item__media {
    max-width: 100px;
    max-height: 100px;
    display: block;
    width: 100%;
    position: relative;
  }
  #{{ section_id }} .cart-items .cart-item__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 1/1;
    max-width: 100px;
    display: block;
  }

  #{{ section_id }} .cart-items .cart-item__actions {
    display: flex;
    align-items: center;
    gap: 32px;
    max-width: 343px;
    width: 100%;
  }
  #{{ section_id }} .cart-items .cart-item__quantity {
    padding: 0;
  }
  #{{ section_id }} .cart-items .cart-item__quantity-wrapper {
    display: flex;
    align-items: center;
    gap: 32px;
  }
  #{{ section_id }} .cart-items .quantity-popover-container {
    padding: 0;
  }
  #{{ section_id }} .cart-items .cart-item cart-remove-button {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0;
    width: 20px;
    height: 20px;
  }
  #{{ section_id }} .cart-items .cart-item cart-remove-button .button {
    min-width: 3rem;
    min-height: 3rem;
  }
  #{{ section_id }} .cart-items .cart-item .cart-item__totals {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  #{{ section_id }} .cart-items .cart-item .cart-item__totals .loading__spinner {
    bottom: auto;
    right: auto;
    padding: 0;
    position: absolute;
    top: 50%;
    left: 50%;
    width: 18px;
    height: 18px;
    transform: translate(-50%, -50%);
  }
  #{{ section_id }} .cart-items .cart-item .cart-item__totals .cart-item__price-wrapper .price {
    margin: 0;
    font-size: 20px;
    font-weight: 600;
    line-height: 24px;
  }
  #{{ section_id }} .cart-items .cart-item__info {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  @media(max-width: 1024px) {
    #{{ section_id }} .cart-items .cart-item__actions {
      display: flex;
      align-items: center;
      gap: 24px;
      max-width: 40%;
      width: 100%;
      justify-content: space-between;
    }
    #{{ section_id }} .cart-items .cart-item__actions .quantity {
      width: calc(12rem / var(--font-body-scale) + var(--inputs-border-width) * 2);
    }
  }
  @media(max-width: 768px) {
    #{{ section_id }} .cart-items .cart-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      position:relative;
    }
    #{{ section_id }} .cart-items .cart-item__media {
      max-width: 80px;
      max-height: 80px;
    }
    #{{ section_id }} .cart-items .cart-item__media img {
      max-width: 80px;
    }
    #{{ section_id }} .cart-items .cart-item__actions {
      max-width: 100%;
    }
    #{{ section_id }} .cart-items .cart-item__actions quantity-popover {
      position: static;
    }
    #{{ section_id }} .cart-items .cart-item cart-remove-button {
      position: absolute;
      top: 16px;
      right: 16px;
    }
    #{{ section_id }} .cart-items .cart-item__quantity-wrapper {
      gap: 16px;
    }
    #{{ section_id }} .cart-items .cart-item .cart-item__totals {
      align-items: center;
      gap: 0;
    }

    #{{ section_id }} .cart-items .cart-item__price-info {
      font-size: 13px;
      line-height: 18px;
    }
    #{{ section_id }} .cart-item__details{
      padding-inline:20px;
    }
  }
{% endstyle %}

<section id="{{ section_id }}">
  <div class="cst-page-width">
    <div class="cst-container">
      <div class="cst-col cst-cart-items-container">
        <cart-items class="gradient color-{{ section.settings.color_scheme }} isolate{% if cart == empty %} is-empty{% else %} section-{{ section.id }}-padding{% endif %}">
          <div class="title-wrapper-with-link">
            <h1 class="title title--primary">
              Basket
              <span
                ><span>(</span><span id="cart-item-count">{{ cart.item_count }}</span> <span>items)</span></span
              >
            </h1>
          </div>

          <div class="cart__warnings">
            <h1 class="cart__empty-text">{{ 'sections.cart.empty' | t }}</h1>
            <a href="{{ routes.all_products_collection_url }}" class="button">
              {{ 'general.continue_shopping' | t }}
            </a>

            {%- if shop.customer_accounts_enabled and customer == null -%}
              <h2 class="cart__login-title">{{ 'sections.cart.login.title' | t }}</h2>
              <p class="cart__login-paragraph">
                {{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}
              </p>
            {%- endif -%}
          </div>

          <form action="{{ routes.cart_url }}" class="cart__contents critical-hidden" method="post" id="cart">
            <div class="cart__items" id="main-cart-items" data-id="{{ section.id }}">
              <div class="js-contents">
                {%- if cart != empty -%}
                  <div class="cart-items">
                    <div class="cart-items-container">
                      {%- for item in cart.items -%}
                        <div
                          class="cart-item {% if item.parent_relationship.parent != null %}cart-item__nested-line{% endif %}"
                          id="CartItem-{{ item.index | plus: 1 }}"
                          {% if item.parent_relationship.parent != null %}
                            aria-label="{{- 'products.product.nested_label' | t: title: item.product.title, parent_title: item.parent_relationship.parent.title | escape -}}"
                          {% endif %}
                        >
                          <div class="cart-item__info">
                            <div class="cart-item__media">
                              {% if item.image %}
                                {% comment %} Leave empty space due to a:empty CSS display: none rule {% endcomment %}
                                <a href="{{ item.url }}" class="cart-item__link" aria-hidden="true" tabindex="-1"> </a>
                                <div class="cart-item__image-container gradient {% if item.parent_relationship.parent == null %}global-media-settings{% endif %}">
                                  <img
                                    src="{{ item.image | image_url: width: 300 }}"
                                    class="cart-item__image {% if item.parent_relationship.parent != null %}global-media-settings{% endif %}"
                                    alt="{{ item.image.alt | escape }}"
                                    loading="lazy"
                                    width="150"
                                    height="{{ 150 | divided_by: item.image.aspect_ratio | ceil }}"
                                  >
                                </div>
                              {% endif %}
                            </div>

                            <div class="cart-item__details">
                              {%- if settings.show_vendor -%}
                                <p class="caption-with-letter-spacing">{{ item.product.vendor }}</p>
                              {%- endif -%}

                              <a href="{{ item.url }}" class="cart-item__name h4 break">
                                {{- item.product.title | escape -}}
                              </a>

                              {%- if item.product.has_only_default_variant == false
                                or item.properties.size != 0
                                or item.selling_plan_allocation != null
                              -%}
                                <dl>
                                  {%- if item.product.has_only_default_variant == false -%}
                                    {%- for option in item.options_with_values -%}
                                      <div class="product-option product-option-variant">
                                        <dt>{{ option.name }}:</dt>
                                        <dd>{{ option.value }}</dd>
                                      </div>
                                    {%- endfor -%}
                                  {%- endif -%}

                                  {%- for property in item.properties -%}
                                    {%- assign property_first_char = property.first | slice: 0 -%}
                                    {%- if property.last != blank and property_first_char != '_' -%}
                                      <div class="product-option product-option-variant">
                                        <dt>{{ property.first }}:</dt>
                                        <dd>
                                          {%- if property.last contains '/uploads/' -%}
                                            <a href="{{ property.last }}" class="link" target="_blank">
                                              {{ property.last | split: '/' | last }}
                                            </a>
                                          {%- else -%}
                                            {{ property.last }}
                                          {%- endif -%}
                                        </dd>
                                      </div>
                                    {%- endif -%}
                                  {%- endfor -%}
                                </dl>

                                <div></div>

                                <p class="product-option">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                              {%- endif -%}

                              <ul
                                class="discounts list-unstyled"
                                role="list"
                                aria-label="{{ 'customer.order.discount' | t }}"
                              >
                                {%- for discount in item.line_level_discount_allocations -%}
                                  <li class="discounts__discount">
                                    {{- 'icon-discount.svg' | inline_asset_content -}}
                                    {{ discount.discount_application.title | escape }}
                                  </li>
                                {%- endfor -%}
                              </ul>
                              {% if item.product.available %}
                                <div class="product-card__availability">
                                  <svg
                                    width="15"
                                    height="11"
                                    viewBox="0 0 15 11"
                                    fill="none"
                                    xmlns="http://www.w3.org/2000/svg"
                                  >
                                    <path d="M13.8125 0.40625C14.2188 0.78125 14.2188 1.4375 13.8125 1.8125L5.8125 9.8125C5.4375 10.2188 4.78125 10.2188 4.40625 9.8125L0.40625 5.8125C0 5.4375 0 4.78125 0.40625 4.40625C0.78125 4 1.4375 4 1.8125 4.40625L5.125 7.6875L12.4062 0.40625C12.7812 0 13.4375 0 13.8125 0.40625Z" fill="#30309F"/>
                                  </svg>
                                  <span class="product-card__availability-text">
                                    <span class="product-card__availability-instock">In Stock</span>
                                    <span class="product-card__availability-other"> | Despatched within 24 Hrs</span>
                                  </span>
                                </div>
                                {% comment %}
                                  {% else %}
                                  <div class="product-card__availability">
                                    <span class="product-card__availability-text" style="color: #f44336;">Out of Stock</span>
                                  </div>
                                {% endcomment %}
                              {% endif %}
                            </div>
                          </div>

                          <div class="cart-item__actions">
                            {%- liquid
                              assign has_qty_rules = false
                              if item.variant.quantity_rule.increment > 1 or item.variant.quantity_rule.min > 1 or item.variant.quantity_rule.max != null
                                assign has_qty_rules = true
                              endif

                              assign has_vol_pricing = false
                              if item.variant.quantity_price_breaks.size > 0
                                assign has_vol_pricing = true
                              endif
                            -%}

                            <div class="cart-item__quantity{% if has_qty_rules or has_vol_pricing %} cart-item__quantity--info{% endif %}">
                              <quantity-popover>
                                <div class="cart-item__quantity-wrapper quantity-popover-wrapper">
                                  <label class="visually-hidden" for="Quantity-{{ item.index | plus: 1 }}">
                                    {{ 'products.product.quantity.label' | t }}
                                  </label>
                                  <div class="quantity-popover-container{% if has_qty_rules or has_vol_pricing %} quantity-popover-container--hover{% endif %}">
                                    {%- if has_qty_rules or has_vol_pricing -%}
                                      <button
                                        type="button"
                                        aria-expanded="false"
                                        class="quantity-popover__info-button quantity-popover__info-button--icon-only button button--tertiary small-hide medium-hide"
                                      >
                                        {{- 'icon-info.svg' | inline_asset_content -}}
                                      </button>
                                    {%- endif -%}
                                    <quantity-input class="quantity cart-quantity">
                                      {% assign can_update_quantity = item.instructions.can_update_quantity
                                        | default: true
                                      %}
                                      <button
                                        class="quantity__button"
                                        name="minus"
                                        type="button"
                                        {% if can_update_quantity == false %}
                                          disabled
                                        {% endif %}
                                      >
                                        <span class="visually-hidden">
                                          {{-
                                            'products.product.quantity.decrease'
                                            | t: product: item.product.title
                                            | escape
                                          -}}
                                        </span>
                                        <span class="svg-wrapper">
                                          {{- 'icon-minus.svg' | inline_asset_content -}}
                                        </span>
                                      </button>
                                      <input
                                        class="quantity__input"
                                        data-quantity-variant-id="{{ item.variant.id }}"
                                        type="number"
                                        name="updates[]"
                                        value="{{ item.quantity }}"
                                        {% # theme-check-disable %}
                                        data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                                        min="0"
                                        data-min="{{ item.variant.quantity_rule.min }}"
                                        {% if item.variant.quantity_rule.max != null %}
                                          max="{{ item.variant.quantity_rule.max }}"
                                        {% endif %}
                                        step="{{ item.variant.quantity_rule.increment }}"
                                        {% # theme-check-enable %}
                                        aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                                        id="Quantity-{{ item.index | plus: 1 }}"
                                        data-index="{{ item.index | plus: 1 }}"
                                        {% if can_update_quantity == false %}
                                          disabled
                                        {% endif %}
                                      >
                                      <button
                                        class="quantity__button"
                                        name="plus"
                                        type="button"
                                        {% if can_update_quantity == false %}
                                          disabled
                                        {% endif %}
                                      >
                                        <span class="visually-hidden">
                                          {{-
                                            'products.product.quantity.increase'
                                            | t: product: item.product.title
                                            | escape
                                          -}}
                                        </span>
                                        <span class="svg-wrapper">
                                          {{- 'icon-plus.svg' | inline_asset_content -}}
                                        </span>
                                      </button>
                                    </quantity-input>
                                  </div>
                                  <cart-remove-button
                                    id="Remove-{{ item.index | plus: 1 }}"
                                    data-index="{{ item.index | plus: 1 }}"
                                    {% assign can_remove = item.instructions.can_remove | default: true %}
                                    {% if can_remove == false %}
                                      class="hidden"
                                    {% endif %}
                                  >
                                    <a
                                      href="{{ item.url_to_remove }}"
                                      class="button button--tertiary"
                                      aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}"
                                    >
                                      <span class="svg-wrapper">
                                        <svg
                                          xmlns="http://www.w3.org/2000/svg"
                                          width="16"
                                          height="18"
                                          viewBox="0 0 16 18"
                                          fill="none"
                                        >
