<script>
  function updatePrices() {
    const totalEl = document.querySelector('.cst-big-text.totals__total-value');
    const cartTotalEl = document.querySelector('#cart-icon-bubble .cst-cart-total');
    const vatEl = document.querySelector('.cst-row-vat span:last-child');
    const vatToggle = document.getElementById('vatToggle'); // checkbox

    if (!totalEl || !cartTotalEl) return;

    // Get original price
    const originalText = cartTotalEl.innerText.replace(/£|,/g, '').trim();
    const originalPrice = parseFloat(originalText);
    if (isNaN(originalPrice)) return;

    let finalPrice = originalPrice;
    let vatAmount = 0;

    // ⚡ IMPORTANT:
    // vatToggle.checked = Inc. VAT
    // vatToggle NOT checked = Exc. VAT (increase price 20%)

    if (!vatToggle.checked) {  
      // Exc. VAT → increase 20%
      vatAmount = originalPrice * 0.2;
      finalPrice = originalPrice * 1.2;
    }

    // Update total
    totalEl.innerText = '£' + finalPrice.toFixed(2);

    // Update VAT amount
    if (vatEl) {
      vatEl.innerText = '£' + vatAmount.toFixed(2);
    }
  }

  // run when toggled
  document.getElementById('vatToggle').addEventListener('change', updatePrices);

  // also run every second to sync with Shopify cart
  setInterval(function () {
    updatePrices();

    // cart count script
    fetch('/cart.js')
      .then((r) => r.json())
      .then((cart) => {
        const el = document.getElementById('cart-item-count');
        if (el && el.textContent != cart.item_count) {
          el.textContent = cart.item_count;
        }
      });
  }, 1000);
</script>


