{% assign section_id = section.id | handle %}

{% comment %} new-card-pproduct.liquid css{% endcomment %}
{% style %}
  #{{ section_id }} .cst-product-card {
      border-radius: 2px;
      overflow: hidden;
      transition: box-shadow 0.3s ease;
      background: transparent;
  }
  #{{ section_id }} .cst-product-card .cst-product-img-box {
      position: relative;
      overflow: hidden;
      aspect-ratio: 1/1;
  }
  #{{ section_id }} .cst-product-card .cst-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.3s ease;
  }
  #{{ section_id }} .cst-product-card:hover .cst-product-img-box .cst-img {
      transform: scale(1.05);
  }
  #{{ section_id }} .cst-product-card .cst-img-secondary {
      position: absolute;
      top: 0;
      left: 0;
      opacity: 0;
      transition: opacity 0.3s ease;
  }
  #{{ section_id }} .cst-product-card:hover .cst-img-secondary {
      opacity: 1;
  }
  #{{ section_id }} .cst-product-card .cst-card-content {
      padding: 1rem;
  }
  #{{ section_id }} .cst-product-card .cst-vendor {
      font-size: 0.875rem;
      color: #212133;
      margin-bottom: 0.25rem;
      font-family: Montserrat, sans-serif;
  }
  #{{ section_id }} .cst-product-card .cst-product-title {
      font-family: Montserrat, sans-serif;
      font-weight: 700;
      font-style: normal;
      font-size: 14px;
      line-height: 20px;
      margin: 0 0 20px 0;
      color: #212133;
  }
  #{{ section_id }} .cst-product-card .cst-product-link {
      text-decoration: none;
      color: inherit;
  }
  #{{ section_id }} .cst-product-card .cst-price-container {
      margin-bottom: 0.5rem;
  }
  #{{ section_id }} .cst-product-card .cst-price-from {
      font-family: Montserrat, sans-serif;
      font-weight: 400;
      font-style: normal;
      font-size: 13px;
      line-height: 18px;
      letter-spacing: 0%;
      vertical-align: middle;
      color: #212133;
  }
  #{{ section_id }} .cst-product-card .cst-price {
      font-family: Montserrat, sans-serif;
      font-weight: 600;
      font-style: normal;
      font-size: 16px;
      line-height: 20px;
      vertical-align: middle;
      color: #30309f;
  }
  #{{ section_id }} .cst-product-card .cst-price-compare {
      font-family: Montserrat, sans-serif;
      font-weight: 400;
      font-style: normal;
      font-size: 13px;
      line-height: 18px;
      letter-spacing: 0%;
      vertical-align: middle;
      text-decoration: line-through;
      color: #999;
      margin-left: 0.25rem;
  }
  #{{ section_id }} .cst-product-card .cst-price-inc {
      font-family: Montserrat, sans-serif;
      font-weight: 400;
      font-style: normal;
      font-size: 13px;
      line-height: 18px;
      color: #212133;
  }
  #{{ section_id }} .cst-product-card .cst-product-availability {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 0.5rem;
  }
  #{{ section_id }} .cst-product-card .cst-product-availability svg {
      flex-shrink: 0;
  }
  #{{ section_id }} .cst-product-card .cst-avilability-text {
      font-family: Montserrat, sans-serif;
      font-size: 13px;
      line-height: 18px;
      letter-spacing: 0%;
      vertical-align: middle;
  }
  #{{ section_id }} .cst-product-card .cst-instock {
      font-weight: 700;
      color: #212133;
  }
  #{{ section_id }} .cst-product-card .cst-within {
      font-weight: 400;
      color: #212133;
  }
  #{{ section_id }} .cst-product-card .cst-product-rating {
      margin-bottom: 0.5rem;
  }
{% endstyle %}

