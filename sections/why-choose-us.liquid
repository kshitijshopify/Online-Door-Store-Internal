<!-- Why Choose Us Section -->
<section class="why-choose-us" id="{{ section.id }}">
  <!-- Left Image Section -->
  <div class="why-choose-us__left">
    {% if section.settings.image != blank %}
      <img
        src="{{ section.settings.image | img_url: '1200x800' }}"
        alt="{{ section.settings.image.alt | escape }}"
        loading="lazy"
        width="1200"
        height="800"
      >
    {% else %}
      <img
        src="https://picsum.photos/1200/800"
        alt="Modern front door"
        loading="lazy"
        width="1200"
        height="800"
      >
    {% endif %}
  </div>

  <!-- Right Content Section -->
  <div class="why-choose-us__right">
    <div class="content-wrapper">
      <h2>{{ section.settings.heading | default: 'WHY CHOOSE US' }}</h2>
      <p>
        {{
          section.settings.description
          | default: 'We know that the right door can completely change the appearance of a home. Quality wooden doors can help you finish your renovation project to a high standard and improve the appearance of your interior design. We pride ourselves on supplying our customers with high-quality internal and external doors to meet their needs.'
        }}
      </p>

      <ul>
        {% if section.settings.benefit1 != blank %}
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none">
              <path d="M2.5 0H15C16.3672 0 17.5 1.13281 17.5 2.5V15C17.5 16.4062 16.3672 17.5 15 17.5H2.5C1.09375 17.5 0 16.4062 0 15V2.5C0 1.13281 1.09375 0 2.5 0ZM13.1641 6.91406H13.125C13.5156 6.5625 13.5156 5.97656 13.125 5.58594C12.7734 5.23438 12.1875 5.23438 11.8359 5.58594L7.5 9.96094L5.66406 8.125C5.27344 7.73438 4.6875 7.73438 4.33594 8.125C3.94531 8.47656 3.94531 9.0625 4.33594 9.41406L6.83594 11.9141C7.1875 12.3047 7.77344 12.3047 8.16406 11.9141L13.1641 6.91406Z" fill="#30309F"/>
            </svg>
            <span>{{ section.settings.benefit1 }}</span>
          </li>
        {% endif %}
        {% if section.settings.benefit2 != blank %}
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none">
              <path d="M2.5 0H15C16.3672 0 17.5 1.13281 17.5 2.5V15C17.5 16.4062 16.3672 17.5 15 17.5H2.5C1.09375 17.5 0 16.4062 0 15V2.5C0 1.13281 1.09375 0 2.5 0ZM13.1641 6.91406H13.125C13.5156 6.5625 13.5156 5.97656 13.125 5.58594C12.7734 5.23438 12.1875 5.23438 11.8359 5.58594L7.5 9.96094L5.66406 8.125C5.27344 7.73438 4.6875 7.73438 4.33594 8.125C3.94531 8.47656 3.94531 9.0625 4.33594 9.41406L6.83594 11.9141C7.1875 12.3047 7.77344 12.3047 8.16406 11.9141L13.1641 6.91406Z" fill="#30309F"/>
            </svg>
            <span>{{ section.settings.benefit2 }}</span>
          </li>
        {% endif %}
        {% if section.settings.benefit3 != blank %}
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none">
              <path d="M2.5 0H15C16.3672 0 17.5 1.13281 17.5 2.5V15C17.5 16.4062 16.3672 17.5 15 17.5H2.5C1.09375 17.5 0 16.4062 0 15V2.5C0 1.13281 1.09375 0 2.5 0ZM13.1641 6.91406H13.125C13.5156 6.5625 13.5156 5.97656 13.125 5.58594C12.7734 5.23438 12.1875 5.23438 11.8359 5.58594L7.5 9.96094L5.66406 8.125C5.27344 7.73438 4.6875 7.73438 4.33594 8.125C3.94531 8.47656 3.94531 9.0625 4.33594 9.41406L6.83594 11.9141C7.1875 12.3047 7.77344 12.3047 8.16406 11.9141L13.1641 6.91406Z" fill="#30309F"/>
            </svg>
            <span>{{ section.settings.benefit3 }}</span>
          </li>
        {% endif %}
      </ul>

      <div class="learn-rating">
        {% if section.settings.button_text != blank %}
          <a href="{{ section.settings.button_link }}" class="learn-more-btn">
            <span>{{ section.settings.button_text }}</span>
          </a>
        {% endif %}

        <!-- App Block for Rating -->
        {% for block in section.blocks %}
          {% case block.type %}
            {% when '@app' %}
              <div class="rating-app-block" {{ block.shopify_attributes }}>
                {% if block.settings.rating_app_code != blank %}
                  {{ block.settings.rating_app_code }}
                {% endif %}
              </div>
          {% endcase %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<style>
    #{{ section.id }} *{
        margin:0;
        padding:0;
        box-sizing:border-box;
    }
    #{{ section.id }}.why-choose-us {
      display: flex;
      align-items: stretch;
      justify-content: space-between;
      width: 100%;
      {% comment %} min-height: 100vh; {% endcomment %}
      overflow: hidden;
      {% if section.settings.layout_direction == 'right' %}
        flex-direction: row-reverse;
      {% endif %}
    }

    /* Left Image Section */
    #{{ section.id }} .why-choose-us__left {
      flex: 1;
      position: relative;
      overflow: hidden;
    }

    #{{ section.id }} .why-choose-us__left img {
      width: 100%;
      object-fit: cover;
      display: block;
    }

    /* Right Content Section */
    #{{ section.id }} .why-choose-us__right {
      flex: 1;
      background-color: {{ section.settings.background_color | default: '#f3f0ff' }};
      display: flex;
      align-items: center;
    }
    
    #{{ section.id }} .content-wrapper {
      width:100%;
      display:flex;
      flex-direction:column;
      gap:48px;
          margin-left: 96px;
          max-width:636px;

    }
    @media (max-width: 1600px) {
        #{{ section.id }} .content-wrapper {
            margin-left: 40px;
        }
    }
    #{{ section.id }} .content-wrapper h2 {
      color: {{ section.settings.heading_color | default: '#30309F' }};
      font-size: 40px;
      font-weight: 600;
      line-height:42px;
      letter-spacing:5%;
      text-transform:uppercase;

    }

    #{{ section.id }} .content-wrapper p {
      max-width:636px;
      font-size: 14px;
      line-height:  20px;
      color: {{ section.settings.text_color | default: '#555' }};
    }

    #{{ section.id }} .content-wrapper ul {
      list-style: none;
      padding:0;
    }

    #{{ section.id }} .content-wrapper ul li {
      margin-bottom: 10px;
      font-size: 15px;
      display: flex;
      align-items: center;
      gap:16px;
      color: {{ section.settings.text_color | default: '#555' }};
  }
  #{{ section.id }} .content-wrapper ul li span{
      font-weight:700;
      line-height:22px;
      font-size:16px;
  }


    #{{ section.id }} .learn-rating{
    }
    #{{ section.id }} .learn-more-btn {
      display: flex;
      align-items:center;
      justify-content:center;
      width:177px;
      height:56px;
      border: 1px solid {{ section.settings.button_color | default: '#3d2eff' }};
      color: {{ section.settings.button_color | default: '#3d2eff' }};
      font-weight: 700;
      text-decoration: none;
      border-radius: 1px;
      transition: all 0.3s ease;
      line-height:18px;
      letter-spacing:5%;
      text-transform:uppercase;
      font-size:15px;
    }

    #{{ section.id }} .learn-more-btn:hover {
      background: {{ section.settings.button_color | default: '#3d2eff' }};
      color: #fff;
    }

    /* Responsive Design */
    @media (max-width: 789px) {
    #{{ section.id }}.why-choose-us {
        display: block;
    }
    #{{ section.id }} .why-choose-us__left img {
        width: 100%;
        object-fit: cover;
        display: block;
        max-height: 375px;
    }
    #{{ section.id }} .why-choose-us__right { 
        padding:20px 16px;
        {% comment %} margin:10px; {% endcomment %}
    }
    #{{ section.id }} .content-wrapper { 
       margin-left:0px;
       gap:40px;
    }
    #{{ section.id }} .content-wrapper h2 { 
        font-size: 32px;
    }
    #{{ section.id }} .learn-more-btn { 
        width:100%;
    }
    }
</style>

{% schema %}
{
  "name": "Why Choose Us",
  "settings": [
    {
      "type": "select",
      "id": "layout_direction",
      "label": "Layout Direction",
      "options": [
        {
          "value": "left",
          "label": "Image Left / Content Right"
        },
        {
          "value": "right",
          "label": "Image Right / Content Left"
        }
      ],
      "default": "left"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WHY CHOOSE US"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "We know that the right door can completely change the appearance of a home. Quality wooden doors can help you finish your renovation project to a high standard and improve the appearance of your interior design. We pride ourselves on supplying our customers with high-quality internal and external doors to meet their needs."
    },
    {
      "type": "text",
      "id": "benefit1",
      "label": "Benefit 1",
      "default": "Quality Internal & External Doors Guaranteed"
    },
    {
      "type": "text",
      "id": "benefit2",
      "label": "Benefit 2",
      "default": "Complete Satisfaction or Your Money Back"
    },
    {
      "type": "text",
      "id": "benefit3",
      "label": "Benefit 3",
      "default": "Response to Queries within 24 Hours"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "LEARN MORE"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f3f0ff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#3d2eff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#555"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#3d2eff"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Color",
      "default": "#3d2eff"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Why Choose Us",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}
