          <div class="cst-row cst-search-row">
            <div class="cst-search-container">
              <form action="{{ routes.search_url }}" method="get" role="search" class="cst-search-form">
                <div class="cst-search-box">
                    <input type="search" name="q" class="cst-search-input" placeholder="Search thousands of door designs..." autocomplete="off" data-cst-search-input>
