    const headerSection = document.querySelector("#{{ section_id }}");
    const toggleBtn = headerSection.querySelector(".cst-mobile-toggle");
    const overlay = headerSection.querySelector(".cst-overlay");
    const closeBtn = headerSection.querySelector(".cst-close-btn");
    const dropdownLinks = headerSection.querySelectorAll(".has-dropdown > a");

    // Drawer toggle
    const openDrawer = () => { headerSection.classList.add("drawer-open"); document.body.classList.add("drawer-open"); };
    const closeDrawer = () => { headerSection.classList.remove("drawer-open"); document.body.classList.remove("drawer-open"); };

    toggleBtn.addEventListener("click", openDrawer);
    closeBtn.addEventListener("click", closeDrawer);
    overlay.addEventListener("click", closeDrawer);
    document.addEventListener("keydown", (e) => e.key === "Escape" && closeDrawer());

    // Accordion dropdown toggle
    dropdownLinks.forEach(link => {
      link.addEventListener("click", function(e) {
        const parent = this.closest(".has-dropdown");

        // prevent link navigation on first click
        e.preventDefault();

        const isActive = parent.classList.contains("active");
        const siblingItems = parent.parentElement.querySelectorAll(".has-dropdown");

        // close siblings (accordion behavior)
        siblingItems.forEach(item => {
          if (item !== parent) item.classList.remove("active");
        });

        // toggle current one
        parent.classList.toggle("active", !isActive);
      });
    });
  });
</script>

