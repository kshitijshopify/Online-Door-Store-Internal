{% comment %} make header and announcement bar sticky on top one after other {% endcomment %}
<script>
  function adjustHeaderTop() {
    const announcementBar = document.querySelector('section.cst-announcement-bar-section');
    const header = document.querySelector('header.cst-header');

    if (!announcementBar || !header) return;

    const barHeight = announcementBar.offsetHeight;
    header.style.top = barHeight + 'px';
  }

  // run on load
  window.addEventListener('load', adjustHeaderTop);

  // run on resize
  window.addEventListener('resize', adjustHeaderTop);

  // optional: run when fonts load or content shifts
  document.addEventListener('DOMContentLoaded', adjustHeaderTop);

</script>

{% comment %} Predictive search result JS {% endcomment %}
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const searchInputs = document.querySelectorAll("[data-cst-search-input]");

    searchInputs.forEach((input) => {
      const container = input.closest(".cst-search-container");
      const resultsBox = container.querySelector("[data-cst-search-results]");

      let debounce;

      function fetchSSR(query) {
        const sectionId = "cst-predictive-search";
        const url = `/search/suggest?q=${encodeURIComponent(query)}&section_id=${sectionId}`;

        fetch(url)
          .then(res => res.text())
          .then(html => {
            resultsBox.innerHTML = html;
            resultsBox.classList.add("active");
          })
          .catch(() => {
            resultsBox.innerHTML = `<div class="cst-search-no-results">Error loading results.</div>`;
            resultsBox.classList.add("active");
          });
      }

      input.addEventListener("input", () => {
        const value = input.value.trim();

        clearTimeout(debounce);

        if (value.length < 2) {
          resultsBox.classList.remove("active");
          return;
        }

        debounce = setTimeout(() => fetchSSR(value), 250);
      });

      // Close on outside click
      document.addEventListener("click", (e) => {
        if (!e.target.closest(".cst-search-container")) {
          resultsBox.classList.remove("active");
        }
      });
    });
  });
</script>


