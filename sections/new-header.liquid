                    <path d="M12.5 5.19531C12.5 3.86719 11.7578 2.65625 10.625 1.95312C9.45312 1.28906 8.00781 1.28906 6.875 1.95312C5.70312 2.65625 5 3.86719 5 5.19531C5 6.5625 5.70312 7.77344 6.875 8.47656C8.00781 9.14062 9.45312 9.14062 10.625 8.47656C11.7578 7.77344 12.5 6.5625 12.5 5.19531ZM3.75 5.19531C3.75 3.4375 4.6875 1.79688 6.25 0.898438C7.77344 0 9.6875 0 11.25 0.898438C12.7734 1.79688 13.75 3.4375 13.75 5.19531C13.75 6.99219 12.7734 8.63281 11.25 9.53125C9.6875 10.4297 7.77344 10.4297 6.25 9.53125C4.6875 8.63281 3.75 6.99219 3.75 5.19531ZM1.25 18.9453H16.25C16.1719 15.8594 13.6328 13.3203 10.5078 13.3203H6.95312C3.82812 13.3203 1.28906 15.8594 1.25 18.9453ZM0 19.0625C0 15.1953 3.08594 12.0703 6.95312 12.0703H10.5078C14.375 12.0703 17.5 15.1953 17.5 19.0625C17.5 19.6875 16.9531 20.1953 16.3281 20.1953H1.13281C0.507812 20.1953 0 19.6875 0 19.0625Z" fill="currentColor"/>
                  </svg>
