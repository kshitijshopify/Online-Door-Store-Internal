                    </div>
                  </div>
                {% endfor %}
              </div>
            </div>
          {% elsif section.settings.collection_layout == 'carousel' %}
            <div class="fire-doors-carousel">
              {% for product in collection.products %}
                <div class="product-card">
                  <div class="product-card__image">
                    <a href="{{ product.url }}">
                      <img src="{{ product.featured_image | img_url: '400x400', crop: 'center' }}" alt="{{ product.featured_image.alt }}" loading="lazy">
                      
                      {% if section.settings.show_second_image and product.images.size > 1 %}
                        <img class="product-card__image-secondary" src="{{ product.images[1] | img_url: '400x400', crop: 'center' }}" alt="{{ product.images[1].alt }}" loading="lazy">
                      {% endif %}
                    </a>
                  </div>
                  
                  <div class="product-card__content">
                    {% if section.settings.show_vendor and product.vendor != blank %}
                      <div class="product-card__vendor">{{ product.vendor }}</div>
                    {% endif %}
                    
                    <h3 class="product-card__title">
                      <a href="{{ product.url }}">{{ product.title }}</a>
                    </h3>
                    
                    <div class="product-card__price-container">
                      <span class="product-card__price-from">From </span>
                      <span class="product-card__price-main">{{ product.price | money }}</span>
                      {% if product.compare_at_price > product.price %}
                        <span class="product-card__price-compare">{{ product.compare_at_price | money }}</span>
                      {% endif %}
                      <span class="product-card__price-inc"> Inc. VAT</span>
                    </div>
                    
                    {% if product.available %}
                      <div class="product-card__availability">
                        <svg width="15" height="11" viewBox="0 0 15 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M13.8125 0.40625C14.2188 0.78125 14.2188 1.4375 13.8125 1.8125L5.8125 9.8125C5.4375 10.2188 4.78125 10.2188 4.40625 9.8125L0.40625 5.8125C0 5.4375 0 4.78125 0.40625 4.40625C0.78125 4 1.4375 4 1.8125 4.40625L5.125 7.6875L12.4062 0.40625C12.7812 0 13.4375 0 13.8125 0.40625Z" fill="#30309F"/>
                        </svg>
                        <span class="product-card__availability-text">
                          <span class="product-card__availability-instock">In Stock</span>
                          <span class="product-card__availability-other"> | Despatched within 24 Hrs</span>
                        </span>
                      </div>
                    {% else %}
                      <div class="product-card__availability">
                        <span class="product-card__availability-text" style="color: #f44336;">Out of Stock</span>
                      </div>
                    {% endif %}
                    
                    {% if section.settings.show_rating %}
                      <div class="product-card__rating">
                        <!-- Rating widget would go here -->
                        <div class="stars">★★★★★</div>
                      </div>
                    {% endif %}
                    
                    {% if section.settings.quick_add != 'none' %}
                      <div class="product-card__quick-add">
                        {% if section.settings.quick_add == 'standard' %}
                          <button class="button button--primary" data-product-id="{{ product.id }}">Add to Cart</button>
                        {% elsif section.settings.quick_add == 'bulk' %}
                          <div class="quick-add-bulk">
                            <button class="button button--primary" data-product-id="{{ product.id }}">Quick Add</button>
                          </div>
                        {% endif %}
                      </div>
                    {% endif %}
                  </div>
                </div>
              {% endfor %}
            </div>
          {% else %}
            <div class="fire-doors-full-width">
              {% for product in collection.products %}
                <div class="product-card">
                  <div class="product-card__image">
                    <a href="{{ product.url }}">
                      <img src="{{ product.featured_image | img_url: '400x400', crop: 'center' }}" alt="{{ product.featured_image.alt }}" loading="lazy">
                      
                      {% if section.settings.show_second_image and product.images.size > 1 %}
                        <img class="product-card__image-secondary" src="{{ product.images[1] | img_url: '400x400', crop: 'center' }}" alt="{{ product.images[1].alt }}" loading="lazy">
                      {% endif %}
                    </a>
                  </div>
                  
                  <div class="product-card__content">
                    {% if section.settings.show_vendor and product.vendor != blank %}
                      <div class="product-card__vendor">{{ product.vendor }}</div>
                    {% endif %}
                    
                    <h3 class="product-card__title">
                      <a href="{{ product.url }}">{{ product.title }}</a>
                    </h3>
                    
                    <div class="product-card__price-container">
                      <span class="product-card__price-from">From </span>
                      <span class="product-card__price-main">{{ product.price | money }}</span>
                      {% if product.compare_at_price > product.price %}
                        <span class="product-card__price-compare">{{ product.compare_at_price | money }}</span>
                      {% endif %}
                      <span class="product-card__price-inc"> Inc. VAT</span>
                    </div>
                    
                    {% if product.available %}
                      <div class="product-card__availability">
                        <svg width="15" height="11" viewBox="0 0 15 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M13.8125 0.40625C14.2188 0.78125 14.2188 1.4375 13.8125 1.8125L5.8125 9.8125C5.4375 10.2188 4.78125 10.2188 4.40625 9.8125L0.40625 5.8125C0 5.4375 0 4.78125 0.40625 4.40625C0.78125 4 1.4375 4 1.8125 4.40625L5.125 7.6875L12.4062 0.40625C12.7812 0 13.4375 0 13.8125 0.40625Z" fill="#30309F"/>
                        </svg>
                        <span class="product-card__availability-text">
                          <span class="product-card__availability-instock">In Stock</span>
                          <span class="product-card__availability-other"> | Despatched within 24 Hrs</span>
                        </span>
                      </div>
                    {% else %}
                      <div class="product-card__availability">
                        <span class="product-card__availability-text" style="color: #f44336;">Out of Stock</span>
                      </div>
                    {% endif %}
                    
                    {% if section.settings.show_rating %}
                      <div class="product-card__rating">
                        <!-- Rating widget would go here -->
                        <div class="stars">★★★★★</div>
                      </div>
                    {% endif %}
                    
                    {% if section.settings.quick_add != 'none' %}
                      <div class="product-card__quick-add">
                        {% if section.settings.quick_add == 'standard' %}
                          <button class="button button--primary" data-product-id="{{ product.id }}">Add to Cart</button>
                        {% elsif section.settings.quick_add == 'bulk' %}
                          <div class="quick-add-bulk">
                            <button class="button button--primary" data-product-id="{{ product.id }}">Quick Add</button>
                          </div>
                        {% endif %}
                      </div>
                    {% endif %}
                  </div>
                </div>
              {% endfor %}
            </div>
          {% endif %}
        </div>

        {% if section.settings.show_view_all_button and collection.products_count > section.settings.columns_desktop %}
          <div class="view-all-button view-all-button--{{ section.settings.view_all_style }}">
            <a href="{{ collection.url }}">View All</a>
          </div>
        {% endif %}

        {% comment %} Navigation & Pagination {% endcomment %}
        <div class="cst-nav-pagi-container">
          <div class="cst-navigations">
            {% if collection and collection.products_count > 0 %}
              <button class="cst-slider-btn cst-slider-prev-btn">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 25 16" fill="currentColor">
                  <path d="M0.28125 7.03125L7.03125 0.28125C7.3125 0 7.82812 0 8.10938 0.28125C8.39062 0.5625 8.39062 1.07812 8.10938 1.35938L2.625 6.79688H23.3438C23.7188 6.79688 24.0938 7.17188 24.0938 7.54688C24.0938 7.96875 23.7188 8.29688 23.3438 8.29688H2.625L8.10938 13.7812C8.39062 14.0625 8.39062 14.5781 8.10938 14.8594C7.82812 15.1406 7.3125 15.1406 7.03125 14.8594L0.28125 8.10938C0 7.82812 0 7.3125 0.28125 7.03125Z" fill="currentColor"/>
                </svg>
              </button>
            {% endif %}
            <div class="cst-swiper-pagination"></div>
            {% if collection and collection.products_count > 0 %}
              <button class="cst-slider-btn cst-slider-next-btn">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 25 16" fill="currentColor">
                  <path d="M23.7656 8.10938L17.0156 14.8594C16.7344 15.1406 16.2188 15.1406 15.9375 14.8594C15.6562 14.5781 15.6562 14.0625 15.9375 13.7812L21.4219 8.29688H0.75C0.328125 8.29688 0 7.96875 0 7.54688C0 7.17188 0.328125 6.79688 0.75 6.79688H21.4219L15.9375 1.35938C15.6562 1.07812 15.6562 0.5625 15.9375 0.28125C16.2188 0 16.7344 0 17.0156 0.28125L23.7656 7.03125C24.0469 7.3125 24.0469 7.82812 23.7656 8.10938Z" fill="currentColor"/>
                </svg>
              </button>
            {% endif %}
          </div>
        </div>

        {% comment %} Slider Navigation {% endcomment %}
         {%if section.settings.cst-btn-container == true %}
          <div class="cst-btn-container">
            <a href="{{ collection.url | default:"#" }}" class="cst-link-btn cst-link-btn-{{ section.settings.view_all_style }}">
              Shop {{ collection.title }}
            </a>
          </div>
        {% endif %}
      {% elsif collection %}
        <p class="text-center">No products found in this collection.</p>
      {% else %}
        <p class="text-center">Please select a collection in the section settings.</p>
      {% endif %}

      {% if section.settings.review_widget != blank %}
        <div class="review-widget-container">
          {{ section.settings.review_widget }}
        </div>
      {% endif %}
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const swiperEl = document.querySelector("#{{ section_id }} .swiper");

    if (swiperEl) {
      new Swiper(swiperEl, {
        {% comment %} slidesPerView: {{ section.settings.columns_desktop }}, {% endcomment %}
        slidesPerView: 4,
        spaceBetween: 24,
        centerInsufficientSlides: true,
        navigation: {
          nextEl: "#{{ section_id }} .cst-slider-next-btn",
          prevEl: "#{{ section_id }} .cst-slider-prev-btn",
        },
        pagination: {
          el: "#{{ section_id }} .cst-swiper-pagination",
          clickable: true
        },
        breakpoints: {
          0: {
            {% comment %} slidesPerView: {{ section.settings.columns_mobile }}, {% endcomment %}
            slidesPerView: 2,
            spaceBetween: 15,
          },
          768: {
            slidesPerView: 4,
            spaceBetween: 24,
            {% comment %} slidesPerView: {{ section.settings.columns_desktop }}, {% endcomment %}
          },
        },
      });
    }
  });
</script>