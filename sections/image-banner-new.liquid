{% schema %}
{
  "name": "Door Shop Banner",
  "class": "door-shop-banner",
  "settings": [
    {
      "type": "header",
      "content": "Main Banner Settings"
    },
    {
      "type": "image_picker",
      "id": "banner_image_desktop",
      "label": "Banner Image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "banner_image_mobile",
      "label": "Banner Image (Mobile)"
    },
    {
      "type": "text",
      "id": "banner_title",
      "label": "Banner Title",
      "default": "YOUR ONE-STOP SHOP FOR HIGH-QUALITY DOMESTIC AND COMMERCIAL DOORS."
    },
    {
      "type": "text",
      "id": "banner_subtitle",
      "label": "Banner Subtitle",
      "default": "UNPATENTIAL DOORS"
    },
    {
      "type": "text",
      "id": "feature_text_1",
      "label": "Feature 1",
      "default": "Quality Internal & External Doors Guaranteed"
    },
    {
      "type": "text",
      "id": "feature_text_2",
      "label": "Feature 2",
      "default": "Complete Satisfaction or Your Money Back"
    },
    {
      "type": "text",
      "id": "feature_text_3",
      "label": "Feature 3",
      "default": "Response to Queries within 24 Hours"
    },
    {
      "type": "text",
      "id": "banner_button_text",
      "label": "Button Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "banner_button_link",
      "label": "Button Link"
    },
    {
      "type": "range",
      "id": "banner_width",
      "label": "Banner Width",
      "min": 300,
      "max": 1920,
      "step": 20,
      "unit": "px",
      "default": 1440
    }
  ],
  "blocks": [
    {
      "type": "product_block",
      "name": "Product Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "block_image",
          "label": "Block Image"
        },
        {
          "type": "text",
          "id": "block_title",
          "label": "Block Title",
          "default": "MAMMATIAN DOORS"
        },
        {
          "type": "text",
          "id": "block_description",
          "label": "Block Description",
          "default": "GET YOU OFF BLACK DOORS BY DEARTA"
        },
        {
          "type": "text",
          "id": "block_button_text",
          "label": "Button Text",
          "default": "SHOP BLACK DOORS"
        },
        {
          "type": "url",
          "id": "block_button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Door Shop Banner",
      "category": "Custom Sections",
      "blocks": [
        {
          "type": "product_block",
          "settings": {
            "block_title": "MAMMATIAN DOORS",
            "block_description": "GET YOU OFF BLACK DOORS BY DEARTA",
            "block_button_text": "SHOP BLACK DOORS"
          }
        },
        {
          "type": "product_block",
          "settings": {
            "block_title": "SHOP THE LOOK",
            "block_description": "1920'S STYLE INTERIOR DOORS",
            "block_button_text": "SHOP 1920'S DOORS"
          }
        },
        {
          "type": "product_block",
          "settings": {
            "block_title": "FIND THE PERFECT DOOR",
            "block_description": "BROWSE OUR COLLECTION",
            "block_button_text": "EXPLORE DOORS"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% assign section_id = section.id | handle %}

<!-- Door Shop Banner Section -->
<section id="door-shop-banner-{{ section_id }}" class="door-shop-banner">
  <div class="banner-container">
    <!-- Left Side - Main Banner -->
    <div class="main-banner">
      <div class="banner-content-box">
        <div class="banner-content">
          <div class="banner-info">
            <h2>{{ section.settings.banner_title }}</h2>
            {% comment %} <p>{{ section.settings.banner_subtitle }}</p> {% endcomment %}
            <ul class="feature-list">
              {% for i in (1..3) %}
                {% assign feature_text = 'feature_text_' | append: i %}
                {% if section.settings[feature_text] != blank %}
                  <li class="list-item">
                    <span class="list-icon">
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none">
                        <path d="M2.5 0H15C16.3672 0 17.5 1.13281 17.5 2.5V15C17.5 16.4062 16.3672 17.5 15 17.5H2.5C1.09375 17.5 0 16.4062 0 15V2.5C0 1.13281 1.09375 0 2.5 0ZM13.1641 6.91406H13.125C13.5156 6.5625 13.5156 5.97656 13.125 5.58594C12.7734 5.23438 12.1875 5.23438 11.8359 5.58594L7.5 9.96094L5.66406 8.125C5.27344 7.73438 4.6875 7.73438 4.33594 8.125C3.94531 8.47656 3.94531 9.0625 4.33594 9.41406L6.83594 11.9141C7.1875 12.3047 7.77344 12.3047 8.16406 11.9141L13.1641 6.91406Z" fill="currentColor"/>
                      </svg>
                    </span>
                    <span class="list-text">{{ section.settings[feature_text] }}</span>
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          </div>
          <div class="banner-btn-box">
            <a href="{{ section.settings.banner_button_link }}" class="link-btn link-btn-fill">
              {{ section.settings.banner_button_text }}
            </a>
          </div>
        </div>
      </div>
      <div class="banner-overlay"></div>
      {% if section.settings.banner_image_desktop != blank %}
        <picture>
          <source media="(max-width: 767px)" srcset="{{ section.settings.banner_image_mobile | img_url: '800x' }}">
          <img 
            src="{{ section.settings.banner_image_desktop | img_url: '1200x' }}" 
            alt="{{ section.settings.banner_title }}"
            class="banner-image"
          >
        </picture>
      {% endif %}
    </div>
    
    <!-- Right Side - Product Blocks -->
    <div class="product-blocks">
      <div class="blocks-swiper swiper">
        <div class="blocks-swiper-wrapper swiper-wrapper">
          {% for block in section.blocks %}
            <div class="blocks-swiper-slide swiper-slide">
              <div class="product-block" {{ block.shopify_attributes }}>
                <div class="block-content">
                  <h3>{{ block.settings.block_title }}</h3>
                  <a href="{{ block.settings.block_button_link }}" class="link-btn link-btn-outline">
                    {{ block.settings.block_button_text }}
                  </a>
                </div>
                <div class="block-overlay"></div>
                {% if block.settings.block_image != blank %}
                  <img 
                    src="{{ block.settings.block_image | img_url: '600x' }}" 
                    alt="{{ block.settings.block_title }}"
                    class="block-image"
                  >
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
      {% comment %} Navigation & Pagination {% endcomment %}
      <div class="cst-nav-pagi-container">
        <div class="cst-navigations">
          {% if section.blocks.size > 0 %}
            <button class="cst-slider-btn cst-slider-prev-btn">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 25 16" fill="currentColor">
                <path d="M0.28125 7.03125L7.03125 0.28125C7.3125 0 7.82812 0 8.10938 0.28125C8.39062 0.5625 8.39062 1.07812 8.10938 1.35938L2.625 6.79688H23.3438C23.7188 6.79688 24.0938 7.17188 24.0938 7.54688C24.0938 7.96875 23.7188 8.29688 23.3438 8.29688H2.625L8.10938 13.7812C8.39062 14.0625 8.39062 14.5781 8.10938 14.8594C7.82812 15.1406 7.3125 15.1406 7.03125 14.8594L0.28125 8.10938C0 7.82812 0 7.3125 0.28125 7.03125Z" fill="currentColor"/>
              </svg>
            </button>
          {% endif %}
          <div class="cst-swiper-pagination"></div>
          {% if section.blocks.size > 0 %}
            <button class="cst-slider-btn cst-slider-next-btn">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 25 16" fill="currentColor">
                <path d="M23.7656 8.10938L17.0156 14.8594C16.7344 15.1406 16.2188 15.1406 15.9375 14.8594C15.6562 14.5781 15.6562 14.0625 15.9375 13.7812L21.4219 8.29688H0.75C0.328125 8.29688 0 7.96875 0 7.54688C0 7.17188 0.328125 6.79688 0.75 6.79688H21.4219L15.9375 1.35938C15.6562 1.07812 15.6562 0.5625 15.9375 0.28125C16.2188 0 16.7344 0 17.0156 0.28125L23.7656 7.03125C24.0469 7.3125 24.0469 7.82812 23.7656 8.10938Z" fill="currentColor"/>
              </svg>
            </button>
          {% endif %}
        </div>
      </div>
    </div>

  </div>
</section>

<style>  
  .banner-container {
    display: flex;
    gap:2px;
    min-height: 600px;
  }
  
  /* Main Banner Styles */
  .main-banner {
    flex: 1;
    position: relative;
    overflow: hidden;
    {% comment %} min-height: 100%; {% endcomment %}
    color: #fff;
  }
  .banner-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
  }
  
  .banner-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to right, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.3) 100%);
    z-index: 2;
    display: block !important;
  }
  
  .banner-content-box {
    position: relative;
    z-index: 3;
    height: 100%;
    max-width: 952px;
    margin-inline: auto;
  }
  .banner-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 96px;
    padding: 62.5px 40px;
    height: 100%;
    max-width: 620px;
    margin-right: auto;
  }

  .banner-info {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .banner-content-box h2 {
    font-size: 40px;
    font-weight: 500;
    line-height: 42px;
    letter-spacing: 1px;
    vertical-align: middle;
    text-transform: uppercase;
    color: inherit;
    margin: 0;
    padding: 0;
    -webkit-text-stroke: 1.1px;
  }
  
  .feature-list {
    list-style-type: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .feature-list .list-item {
    display: flex;
    gap: 16px;
    align-items: center;
  }
  .feature-list .list-icon {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 18px;
    height: 18px;
  }
  .feature-list .list-text {
    font-size: 16px;
    font-weight: 700;
    line-height: 22px;
    letter-spacing: 0%;
  }

  .link-btn {
    text-decoration: none;
    display: flex;
    justify-content: center;
    align-items: center;
    padding-inline: 32px;
    height: 56px;
    width: fit-content;
    min-width: 220px;
    text-wrap: nowrap;
    white-space: nowrap;
    font-size: 15px;
    font-weight: 500;
    line-height: 18px;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.4s;
    box-sizing: border-box;
    backdrop-filter: blur(8px);
    -webkit-text-stroke: 0.3px;
  }
  .link-btn-outline,
  .link-btn-fill:hover {
    color: #FFF;
    background: transparent;
    border: 1px solid #FFF;
  }
  .link-btn-fill,
  .link-btn-outline:hover {
    color: #fff;
    background-color: #30309F;
    border: 1px solid #30309F;
  }
  
  /* Product Blocks Styles */
  .product-blocks {
    flex: 1;
    max-width: 480px;
  }
  .blocks-swiper {
    height: 600px;
  }
  .blocks-swiper-wrapper {
    
  }
  .blocks-swiper-slide {
    
  }
  .product-block {
    position: relative;
    overflow: hidden;
    display: flex;
    height: 100%;
  }
  
  .block-content {
    position: relative;
    z-index: 3;
    color: white;
    padding: 32px 16px 16px 16px;
    min-width: 235px;
    width: 100%;
    max-width: 55%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  
  .block-content h3 {
    font-size: 16px;
    font-weight: 500;
    line-height: 20px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: inherit;
    margin: 0;
    padding: 0;
    -webkit-text-stroke: 0.5px;
  }
  
  .block-content p {
    margin: 0;
  }

  .block-content .link-btn {
    width: 100%;
  }

  .block-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
  }
  
  .block-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to right, rgba(0,0,0,0.5) 0%, rgba(0,0,0,0.2) 30%);
    z-index: 2;
    display: block !important;
  }

  {% comment %} Navigation and Pagination Style {% endcomment %}

  #door-shop-banner-{{ section_id }} .cst-nav-pagi-container {
    display: none;
    justify-content: center;
    align-items: center;
    margin-top: 16px;
    margin-bottom: 4px;
  }
  #door-shop-banner-{{ section_id }} .cst-nav-pagi-container:has(.cst-slider-prev-btn:disabled):has(.cst-slider-next-btn:disabled) {
    display: none;
  }
  #door-shop-banner-{{ section_id }} .cst-navigations  {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 40px;
  }
  #door-shop-banner-{{ section_id }} .cst-slider-btn {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    margin: 0;
    border: none;
    outline: none;
    background: transparent;
    cursor: pointer;
    color: #212133;
    opacity: 1;
    transition: all 0.4s;
    box-sizing: border-box;
  }
  #door-shop-banner-{{ section_id }} .cst-slider-btn svg {
    width: 24px;
    height: 24px;
    fill: #212133;
  }
  #door-shop-banner-{{ section_id }} .cst-slider-btn:disabled {
    opacity: 0.5;
    cursor: default;
  }
  #door-shop-banner-{{ section_id }} .cst-navigations:has(.cst-slider-prev-btn:disabled):has(.cst-slider-next-btn:disabled) .cst-slider-btn {
    display: none;
  }
  #door-shop-banner-{{ section_id }} .cst-swiper-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }
  #door-shop-banner-{{ section_id }} .cst-swiper-pagination .swiper-pagination-bullet {
    display: inline-block;
    width: 12px;
    height: 12px;
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    opacity: 1;
    border: 1px solid #212133;
    background-color: transparent;
  }
  #door-shop-banner-{{ section_id }} .cst-swiper-pagination .swiper-pagination-bullet-active {
    background-color: #212133;
  }
  
  /* Mobile Styles */
  @media (max-width: 1024px) {
    .banner-container {
      flex-direction: column;
    }
    
    .main-banner {
      min-height: 500px;
    }
    
    .banner-content {
      padding: 32px 24px;
      max-width: 100%;
      justify-content: space-between;
      min-height: 500px;
    }
    .banner-content-box h2 {
      font-size: 32px;
      line-height: 36px;
    }
    
    .feature-list .list-text {
      font-size: 14px;
      line-height: 20px;
    }

    .banner-overlay {
      background: linear-gradient(to bottom, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.1) 40%);
    }

    .product-blocks {
      max-width: 100%;
    }
    .blocks-swiper {
      height: 198px;
      max-height: 198px;
    }

    #door-shop-banner-{{ section_id }} .cst-nav-pagi-container {
      display: flex;
    }

    .block-overlay {
      background: linear-gradient(to bottom, rgba(0,0,0,0.5) 0%, rgba(0,0,0,0.2) 50%);
    }
  }

  @media(max-width: 640px) {
    .main-banner .link-btn {
      width: 100%;
    }
  }
</style>

<script>
  // Mobile slider functionality
  document.addEventListener('DOMContentLoaded', function() {
    const swiperEl = document.querySelector("#door-shop-banner-{{ section_id }} .swiper");

    if (swiperEl) {
      new Swiper(swiperEl, {
        slidesPerView: 1,
        spaceBetween: 2,
        direction: "horizontal",
        loop: false,
        navigation: {
          nextEl: "#door-shop-banner-{{ section_id }} .cst-slider-next-btn",
          prevEl: "#door-shop-banner-{{ section_id }} .cst-slider-prev-btn",
        },
        pagination: {
          el: "#door-shop-banner-{{ section_id }} .cst-swiper-pagination",
          clickable: true
        },
        breakpoints: {
          0: {
            slidesPerView: 1,
            spaceBetween: 2,
            direction: "horizontal",
          },
          1025: {
            slidesPerView: 3,
            spaceBetween: 2,
            direction: "vertical",
          },
        },
      });
    }
  });
</script>
