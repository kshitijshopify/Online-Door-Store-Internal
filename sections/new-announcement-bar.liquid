
{% assign section_id = section.id | handle %}

{% style %}
  .cst-announcement-bar-section {
    position: sticky;
    top: 0;
  }
  #{{ section_id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  }
  #{{ section_id }} .cst-container {
    max-width: 1440px;
    margin-inline: auto;
    padding-block: 8px;
    padding-inline: 40px;
  }
  #{{ section_id }} .cst-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
  }
  #{{ section_id }} .cst-announcement {
    font-size: 14px;
    font-weight: 700;
    text-align: center;
    line-height: 20px;
    color: inherit;
  }

  #{{ section_id }} .cst-vat-toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    position: relative;
  }
  #{{ section_id }} .cst-vat-toggle input {
    appearance: none;
    width: 0;
    height: 0;
    display: inline-block;
    opacity: 0;
    visibility: hidden;
    position: absolute;
    top: 0;
    left: 0;
  }
  #{{ section_id }} .cst-vat-toggle label {
    font-size: 12px;
    font-weight: 700;
    line-height: 100%;
  }
  #{{ section_id }} .cst-toggle {
    display: flex;
    width: 48px;
    border-radius: 50px;
    border: 1px solid {{ section.settings.text_color }};
    position: relative;
  }
  #{{ section_id }} .cst-toggle span {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 32px;
    height: 12px;
    border-radius: 50px;
    background-color: {{ section.settings.text_color }};
    color: {{ section.settings.bg_color }};
    text-transform: uppercase;
    font-size: 11px;
    font-weight: 700;
    line-height: 100%;
    transition: all 0.3s;
    position: relative;
    left: 0px;
  }
  #{{ section_id }} input#inc:checked ~ .cst-toggle span {
    left: -1px;
  }
  #{{ section_id }} input#exc:checked ~ .cst-toggle span {
    left: 15px;
  }

  @media(max-width: 768px) {
    #{{ section_id }} {
      background-color: {{ section.settings.bg_color_mobile | default: section.settings.bg_color }};
    }
    #{{ section_id }} .cst-container {
        padding-inline: 40px;
    }
    #{{ section_id }} .cst-row {
        justify-content: center;
    }
    #{{ section_id }} .cst-announcement {
      font-size: 13px;
      line-height: 18px;
    }
    #{{ section_id }} .cst-vat-container {
        display: none;
    }
  }
{% endstyle %}

<div id="{{ section_id }}">
    <div class="cst-container">
        <div class="cst-row">
            <div class="cst-col">
                <div class="cst-announcement">{{ section.settings.text }}</div>
            </div>
            <div class="cst-col cst-vat-container">
                   {% render 'vat-toggle' %}
            </div>
        </div>
    </div>
  </div>

{% schema %}
{
    "name": "New Announcement",
    "tag": "section",
    "class": "cst-announcement-bar-section",
    "settings": [
        {
            "type": "text",
            "label": "text",
            "id": "text",
        },
        {
            "type": "color",
            "label": "Background Color",
            "id": "bg_color",
            "default": "#30309F"
        },
        {
            "type": "color",
            "label": "Background Color - mobile",
            "id": "bg_color_mobile",
            "default": "#0A0094"
        },
        {
            "type": "color",
            "label": "Text Color",
            "id": "text_color",
            "default": "#FFF"
        },
    ],
    "presets": [
        {
            "name": "New Announcement Bar"
        }
    ]
}
{% endschema %}