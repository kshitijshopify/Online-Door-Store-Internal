<section
  id="nx-breadcrumbs-{{ section.id }}"
  class="nx-breadcrumbs color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding"
  aria-label="Breadcrumb"
>
  {%- liquid
    assign t = template | split: '.' | first
    assign btn_col = nil
    if t == 'product'
      if product and product.metafields.custom.breadcrumb_collection
        assign btn_col = product.metafields.custom.breadcrumb_collection.value
      endif
      if btn_col == nil and product and product.collections.size > 0
        assign btn_col = product.collections.first
      endif
    endif

    assign crumb_col = nil
    if t == 'product'
      if collection
        assign crumb_col = collection
      elsif product and product.metafields.custom.breadcrumb_collection
        assign crumb_col = product.metafields.custom.breadcrumb_collection.value
      elsif product and product.collections.size > 0
        assign crumb_col = product.collections.first
      endif
    elsif t == 'collection'
      if collection and collection.metafields.custom.breadcrumb_collection
        assign crumb_col = collection.metafields.custom.breadcrumb_collection.value
      endif
    endif

    assign vendor_label = ''
    if t == 'product' and section.settings.show_vendor and product and product.vendor != blank
      assign vendor_label = product.vendor
    endif
  -%}

  <div class="page-width nx-breadcrumbs__row">
    {%- if btn_col and t == 'product' -%}
      <a class="nx-crumb__btn button button--secondary" href="{{ btn_col.url }}">
        {{ section.settings.btn_prefix }} {{ btn_col.title | upcase }}
      </a>
    {%- endif -%}

    <nav class="breadcrumbs nx-crumbs" role="navigation" aria-label="breadcrumbs">
      <ol class="breadcrumbs__list" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a class="breadcrumbs__link" itemprop="item" href="{{ routes.root_url }}"><span itemprop="name">Home</span></a>
          <meta itemprop="position" content="1">
        </li>

        {%- if t == 'product' and crumb_col -%}
          <li class="breadcrumbs__sep" aria-hidden="true">|</li>
          <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a class="breadcrumbs__link" itemprop="item" href="{{ crumb_col.url }}"><span itemprop="name">{{ crumb_col.title }}</span></a>
            <meta itemprop="position" content="2">
          </li>

          {%- if section.settings.show_product_title -%}
            <li class="breadcrumbs__sep" aria-hidden="true">|</li>
            <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <a class="breadcrumbs__link" href="{{ product.url | within: crumb_col }}" aria-current="page">
                <span itemprop="name">{{ product.title }}</span>
              </a>
              <meta itemprop="position" content="3">
            </li>
          {%- elsif vendor_label != '' -%}
            <li class="breadcrumbs__sep" aria-hidden="true">|</li>
            <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <a class="breadcrumbs__link" href="/collections/vendors?q={{ vendor_label | url_encode }}">
                <span itemprop="name">{{ vendor_label }}</span>
              </a>
              <meta itemprop="position" content="3">
            </li>
          {%- endif -%}
        {%- endif -%}

        {%- if t == 'collection' -%}
          {%- if crumb_col -%}
            <li class="breadcrumbs__sep" aria-hidden="true">|</li>
            <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <a class="breadcrumbs__link" itemprop="item" href="{{ crumb_col.url }}"><span itemprop="name">{{ crumb_col.title }}</span></a>
              <meta itemprop="position" content="2">
            </li>
          {%- endif -%}
          <li class="breadcrumbs__sep" aria-hidden="true">|</li>
          <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a class="breadcrumbs__link" href="{{ collection.url }}" aria-current="page"><span itemprop="name">{{ collection.title }}</span></a>
            <meta itemprop="position" content="3">
          </li>
        {%- endif -%}
      </ol>
    </nav>
  </div>

  <style>
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.pad_top_mob }}px;
      padding-bottom: {{ section.settings.pad_bottom_mob }}px;
    }
    @media (min-width: 990px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.pad_top }}px;
        padding-bottom: {{ section.settings.pad_bottom }}px;
      }
    }
    .nx-breadcrumbs__row {
      display: flex;
      align-items: center;
      gap: 24px;
    }
    .nx-crumb__btn {
      white-space: nowrap;
      font-weight: 700;
      letter-spacing: normal;
      padding: 0 16px;
      height: 40px;
      min-height: 40px;
    }
    .breadcrumbs { margin: 0; }
    .breadcrumbs__list {
      list-style-type: none;
      margin: 0;
      padding: 0;
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
    }
    .breadcrumbs__sep {
      color: rgba(var(--color-foreground), 0.6);
      font-size: 14px;
      line-height: 1;
    }
    .breadcrumbs__item { display: inline-block; }
    .breadcrumbs__link {
      text-decoration: underline;
      color: rgb(var(--color-foreground));
      font-size: 14px;
    }
    .breadcrumbs__link[aria-current='page'] {
      color: rgb(var(--color-foreground));
      font-weight: normal;
      text-decoration: none;
    }
    .breadcrumbs__link[aria-current='page']:hover,
    .breadcrumbs__link[aria-current='page']:focus {
      text-decoration: underline;
    }
    @media (max-width: 749px){
      .nx-breadcrumbs__row { flex-direction: column; align-items: flex-start; gap: 14px; }
      .nx-crumb__btn {
          order: 2;
          width: 100%;
          font-size: 13px;
      }
      .breadcrumbs__link {
        font-size: 13px;
      }
    }
  </style>
</section>

{% schema %}
{
  "name": "Breadcrumbs",
  "settings": [
    { "type": "text", "id": "btn_prefix", "label": "Button prefix", "default": "VIEW ALL" },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor (PDP, when product title is off)", "default": true },
    { "type": "checkbox", "id": "show_product_title", "label": "Show product title as current crumb (PDP)", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "pad_top", "label": "Desktop padding top", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "pad_bottom", "label": "Desktop padding bottom", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "pad_top_mob", "label": "Mobile padding top", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "pad_bottom_mob", "label": "Mobile padding bottom", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 16 }
  ],
  "presets": [
    { "name": "Breadcrumbs" }
  ]
}
{% endschema %}
