              </svg>
            </h4>
            <ul>
              {% for link in block.settings.menu.links %}
                <li>
                  <a href="{{ link.url }}">{{ link.title }}</a>
                </li>
              {% endfor %}
            </ul>
          </div>
      {% endcase %}
    {% endfor %}
  </div>
</footer>
<!-- Bottom Bar -->
<div class="bottom-bar-container">
  <div class="bottom-bar">
    <p>{{ section.settings.copyright_text }}</p>

    <div class="payment-icons">
      {{ section.settings.bottom_iconst }}
    </div>
  </div>
</div>

<script>
  // Mobile accordion functionality for footer columns
  document.addEventListener('DOMContentLoaded', function () {
    if (window.innerWidth <= 768) {
      const footerCols = document.querySelectorAll('.footer-col');

      footerCols.forEach((col) => {
        const heading = col.querySelector('h4');

        heading.addEventListener('click', function () {
          // Close all other columns
          footerCols.forEach((otherCol) => {
            if (otherCol !== col) {
              otherCol.classList.remove('active');
            }
          });

          // Toggle current column
          col.classList.toggle('active');
        });
      });
    }
  });
</script>

{% schema %}
{
  "name": "Footer New",
  "settings": [
    {
      "type": "header",
      "content": "Newsletter Settings"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show Newsletter",
      "default": true
