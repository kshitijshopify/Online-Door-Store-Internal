<!-- sections/footer.liquid -->
<style>
  /* ---------------------------------------------------
      NEWSLETTER TOP (MOBILE & DESKTOP)
  --------------------------------------------------- */
  .newsletter-box {
    width: 100%;
    background: {{ section.settings.newsletter_bg_color }};
    color: {{ section.settings.newsletter_text_color }};
    text-align: center;
  }

  .newsletter-box .newsletter-box-wrapper{
    max-width:1920px;
    width:100%;
    padding:72px clamp(20px, 12vw, 228px);
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin: 0 auto;
  }

  .newsletter-box h3 {
    font-weight: 600;
    font-size: 32px;
    line-height: 36px;
    text-transform: uppercase;
    letter-spacing: 5%;
    color:inherit;
    display: flex;
    max-width:725px;
    margin:0;
    text-align: left;
    padding:0 clamp(5px, 12vw, 40px);
  }
  .newsletter-form{
    padding:2px;
    background: white;
    display: flex;
    flex: 1;
    max-width:644px;
    position:relative;
  }

  .newsletter-form input {
    width: 100%;
    padding: 16px;
    border: none;
    outline: none;
    font-size: 14px;
    line-height:20px;
    color:#212133;
    min-width: 200px;
  }
  .newsletter-form input::placeholder{
    color:#000;
  }
  .newsletter-form button {
    width: 100%;
    max-width: 160px;
    padding: 17px;
    background: {{ section.settings.newsletter_btn_color }};
    color: {{ section.settings.newsletter_btn_text_color }};
    font-weight: 700;
    border: none;
    cursor: pointer;
    text-align:center;
    font-size: 15px;
    text-transform: uppercase;
    line-height:18px;
  }

  .newsletter-message {
    margin-top: 10px;
    font-size: 14px;
    position: absolute;
    color: #74cf57;
    top: 100%;
    left: 0;
    text-transform: uppercase;
  }

  /* ---------------------------------------------------
        FOOTER MAIN (DESKTOP)
  --------------------------------------------------- */
  footer {
    width:100%;
    background: {{ section.settings.footer_bg_color }};
  }

  .footer-wrapper {
    max-width:1920px;
    padding: 72px clamp(20px, 12vw, 228px);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 122px;
    margin:0 auto;
  }

  /* LEFT COLUMN */
  .footer-company {
    {% comment %} max-width: 320px; {% endcomment %}
  }

  .footer-company img {
    width: 316px;
    height: 56px;
    object-fit: contain;
  }

  .footer-company .contact-item {
    display: flex;
    font-size: 14px;
    line-height: 20px;
    margin-top:40px ;
    gap: 16px;
  }
  .footer-company .contact-item > div{
    display: flex;
    flex-direction: column;
  }

  .footer-company .contact-item > div span,
  .footer-company .contact-item > div a {
    font-weight:300;
    font-size:20px;
    line-height:20px;
    letter-spacing:0%;
    text-decoration: none;
    color:inherit;
  }
  .footer-company .contact-item > div b {
    font-weight:700;
  }

  .footer-company .social-icons {
    display: flex;
    gap: 16px;
    margin-top: 40px;
  }

  .footer-company .social-icons a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: {{ section.settings.social_icon_bg_color }};
    color: {{ section.settings.social_icon_color }};
    transition: all 0.3s ease;
  }
  .footer-company .social-icons a.blog-link {
    width: auto;
    border-radius: 20px;
    padding: 13px 16px;
    color: #2a2a80;
    background: #EBEBFF;
    text-decoration: none;
    font-size: 14px;
    font-weight: 400;
    gap: 4px;
  }

  .footer-company .social-icons a:hover {
    background: {{ section.settings.social_icon_hover_bg_color }};
    transform: translateY(-2px);
  }
  .trust-box img {
    height: 20px;
    margin-top: 10px;
  }

  /* RIGHT COLUMNS */
  .footer-col h4 {
    font-weight: 700;
    font-size: 15px;
    line-height: 18px;
    text-transform: uppercase;
    letter-spacing: 5%;
    margin: 0px;
    margin-bottom:40px;
    color: {{ section.settings.heading_color }};

  }

  .footer-col ul {
    list-style: none;
    padding:0;
  }

  .footer-col ul li {
    margin-bottom: 12px;
  }

  .footer-col ul li a {
    text-decoration: none;
    color: {{ section.settings.link_color }};
    font-size: 14px;
    line-height: 20px;
    font-weight: 400;
    transition: color 0.3s ease;
    text-transform: capitalize;
  }

  .footer-col ul li a:hover {
    color: {{ section.settings.link_hover_color }};
  }

  /* ---------------------------------------------------
    BOTTOM BAR
  --------------------------------------------------- */
  .bottom-bar-container {
    background:#EBEBFF;
    padding-inline: 56px;
  }
  .bottom-bar {
    {% comment %} margin-top: 40px; {% endcomment %}
    {% comment %} padding-top: 20px; {% endcomment %}
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 100%;
    max-width: 1464px;
    margin-inline: auto;
    padding-block: 8px;
  }

  .bottom-bar p {
    font-size: 14px;
    color: {{ section.settings.copyright_color }};
    margin:0;
  }

  .payment-icons {
    display: flex;
    gap: 10px;
    flex-wrap:wrap;
    justify-content:center;
  }

  .payment-icons svg {
    width: 40px;
    height: 26px;
  }
  .footer-col h4  svg{
      display:none;
    }

  /* ---------------------------------------------------
      RESPONSIVE — MOBILE
  --------------------------------------------------- */
  @media(max-width: 1440px) {
    .footer-wrapper, .newsletter-box .newsletter-box-wrapper{
      padding: 72px clamp(20px, 3vw, 228px);
    }
    .newsletter-box h3{
      padding:0;
    }
  }
  @media(max-width: 1024px) {
    .footer-wrapper{
      gap:40px;
    }
    .newsletter-box h3{
      font-size:25px;
    }
    .newsletter-form{
      flex-direction:column;
      background:none;
    }
    .newsletter-form input{
      max-width:100%;
    }
    .newsletter-form button{
      max-width:100%;
    }

  }
  @media(max-width: 768px) {
    .newsletter-box .newsletter-box-wrapper {
      flex-direction: column;
      padding: 56px 16px;
      gap: 20px;
    }
    .newsletter-box h3 {
      text-align: center;
      padding: 0;
    }

    .newsletter-form {
      width: 100%;
      gap: 8px;
    }
    footer {
      padding: 40px 16px;
      padding-bottom:19px;
    }
    .footer-wrapper {
      grid-template-columns: 1fr;
      gap: 0px;
      padding: 40px 13px;
      padding-bottom:0;
    }
    .footer-company .social-icons{
      gap:13.54px;
    }

    .footer-col h4  svg{
      display:block;
    }
    .footer-col{
      border-top: 1px solid #212133 ;
    }

     @media (max-width: 767px) {
      .social-icons{
            width: 100%;
            justify-content: center;
            align-items: center;
            margin-bottom: 20px;
      }
    }
    .footer-wrapper > .footer-col.menu_itqtyt {
      border: none;
      margin-top:40px;
    }
    .footer-col.active ul{
      padding: 0 16px;
    }

    .footer-col h4 {
      padding: 19px 16px;
      cursor: pointer;
      position: relative;
      margin:0;
            display: flex;
    align-items: center;
    justify-content: space-between;
    }

    .footer-col ul {
      display: none;
      margin-top: 15px;
    }

    .footer-col.active ul {
      display: block;
    }

    .bottom-bar {
      flex-direction: column;
      height: auto;
      gap: 16px;
      text-align: center;
      padding: 24px 16px;
      margin:0;
    }

    .footer-company img {
      max-width: 100%;
      height: auto;
    }
  }
</style>

<!-- NEWSLETTER (Mobile first) -->
{% if section.settings.show_newsletter %}
  <div class="newsletter-box">
    <div class="newsletter-box-wrapper">
      <h3>{{ section.settings.newsletter_heading }}</h3>
      {% form 'customer', class: 'newsletter-form' %}
        <input type="email" name="contact[email]" placeholder="{{ section.settings.newsletter_placeholder }}" required>
        <button type="submit">{{ section.settings.newsletter_button }}</button>

        {% if form.posted_successfully? %}
          <p class="newsletter-message">you exclusive newsletter</p>
        {% endif %}
      {% endform %}
    </div>
  </div>
{% endif %}

